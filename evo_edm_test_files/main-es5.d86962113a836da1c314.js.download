lt","Image showing yes answer option and observations icon highlighted.","width","600","height","209","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_16.png",1,"my-3",2,"border","solid 2px"],["alt","Image of the No Icon answer choice.","width","50","height","41","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_17.png",1,"my-3",2,"border","solid 0px"],["alt","Image showing No answer option and Observations icon highlighted.","width","600","height","206","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_18.png",1,"my-3",2,"border","solid 2px"],["alt","Alternate icon image.","width","50","height","45","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_19.png",1,"my-3",2,"border","solid 0px"],["alt","Image showing Alternate answer option highlighted with corresponding justification text box.","width","150","height","110","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_20.png",1,"my-3",2,"border","solid 1px"],["alt","Image shows flag icon highlighted for a practice question needing further review.","width","400","height","181","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_21.png",1,"my-3",2,"border","solid 1px"],["href","/resource-library","target","_blank"],["alt","Image shows supplemental guidance icon and references displayed when clicked.","width","600","height","228","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_22.png",1,"my-3",2,"border","solid 1px"],[1,"mb-1"],["alt","Image shows Comments Icon with Red Dot Indicator to show a comment has been made. ","width","600","height","210","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_23.png",1,"my-3",2,"border","solid 1px"],[1,"mb-3"],["alt","Image shows Artifacts and Documents icon.","width","600","height","164","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_24.png",1,"my-3",2,"border","solid 1px"],["alt","Image shows Artifacts and Documents function with a document attached.","width","600","height","198","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_25.png",1,"my-3",2,"border","solid 1px"],["alt","","width","40","height","31","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_26.png",1,"de_780D01ADE8",2,"border","solid 0px"],["alt","Image shows the Assessment Documents location under the Tools menu.","width","400","height","347","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_27.png",1,"my-3",2,"border","solid 0px"],["alt","","width","600","height","390","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_28.png",1,"my-3",2,"border","solid 0px"],["alt","Image showing the References Icon highlighted expanding the CMMC Source Documents and Help Documents available.","width","600","height","142","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_29.png",1,"my-3",2,"border","solid 2px"],["alt","Image shows Observations Icon highlighted.","width","600","height","151","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_30.png",1,"my-3",2,"border","solid 1px"],["alt","","width","600","height","323","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_31.png",1,"my-3",2,"border","solid 0px"],["alt","","width","600","height","557","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_32.png",1,"de_780D01ADE8",2,"border","solid 0px"],["alt","Image shows Feedback Icon highlighted with comments in text box.","width","600","height","179","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_33.png",1,"my-3",2,"border","solid 1px"],["alt","Image shows the Results tab selected.","width","350","height","44","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_34.png",1,"my-3"],["href","/Documents/htmlhelp_cmmc/3_2__results.htm","target","_blank"],["href","/Documents/htmlhelp_cmmc/reports.htm","target","_blank"],["alt","Image shows the Feedback screen with an option to email.","width","650","height","425","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_35.png",1,"my-3"],[3,"page"]],template:function(n,t){if(1&n){aa(0,"div",0),aa(1,"h3",1),Qa(2,"CMMC Tutorial"),ca(),aa(3,"div",2),aa(4,"h4"),Qa(5,"Overview"),ca(),aa(6,"p"),Qa(7,"In general, a maturity model is a set of characteristics, attributes, indicators, or patterns that represent capability and progression in a particular discipline. The content of such a model typically exemplifies best practices and may incorporate standards or other codes of practice of that discipline. A maturity model thus provides a benchmark against which an organization can evaluate the current level of capability of its processes, practices, and methods and set goals and priorities for improvement."),ca(),aa(8,"p"),Qa(9,"The CMMC assessment process provides consistent guidance for assessing a contractor against a specific CMMC level."),ca(),ca(),aa(10,"div",2),aa(11,"h5"),Qa(12,"Cybersecurity Maturity Model Certification (CMMC)"),ca(),aa(13,"p"),Qa(14," CMMC stands for \u201cCybersecurity Maturity Model Certification\u201d and is a unifying standard for the implementation of cybersecurity across the Defense Industrial Base (DIB). The CMMC framework includes a comprehensive and scalable certification element to verify the implementation of processes and practices associated with the achievement of a cybersecurity maturity level. CMMC is designed to provide increased assurance to the Department that a DIB company can adequately protect sensitive unclassified information, accounting for information flow down to subcontractors in a multi-tier supply chain. "),ca(),ca(),aa(15,"div",2),aa(16,"h5"),Qa(17,"CMMC Levels and Focus Areas"),ca(),aa(18,"p"),Qa(19," CMMC Levels 1 through 3 consist of the security requirements specified in National Institute of Standards and Technology (NIST) Special Publication (SP) 800-171, Protecting Controlled Unclassified Information in Nonfederal Systems and Organizations. Levels 1 through 3 also include an additional 20 CMMC specific- practices along with 3 CMMC maturity processes for each of the 17 CMMC domains. "),ca(),aa(20,"p"),Qa(21," CMMC Levels 4 and 5 include a subset of the enhanced security requirements from NIST SP 800-171B as well as other cybersecurity best practices and show that the contractor is capable of reducing the risk of Advanced Persistent Threats. "),ca(),aa(22,"p"),Qa(23," As a contractor moves toward Level 5, they are required to standardize and optimize process implementation across the organization. "),ca(),ca(),aa(24,"div",2),aa(25,"h5"),Qa(26,"Setting the Target Level"),ca(),aa(27,"p"),Qa(28," The first step to completing the CMMC practice questions is to set your desired target level. If you are unsure of your target level, check your RFI or RFP documents for the required CMMC compliance level for your contract or choose your level based on the following guidance. Additional guidance on CMMC Levels can be found in the CSET Resource Library's collection of CMMC materials. Recommended reading includes the "),aa(29,"a",3),Qa(30,"CMMC Model Certification 1.02 (March 2020)"),ca(),Qa(31,", "),aa(32,"a",4),Qa(33,"CMMC Assessment Guide: Level 1 v.1.10 (November 2020)"),ca(),Qa(34,", and "),aa(35,"a",5),Qa(36,"CMMC Assessment Guide: Level 3, v.1.10 (November 2020)"),ca(),Qa(37,". "),ca(),aa(38,"ul"),aa(39,"li"),Qa(40,"Level 1: Safeguard Federal Contract Information (FCI)"),ca(),aa(41,"li"),Qa(42,"Level 2: Serve as transition step in cybersecurity maturity progression to protect CUI"),ca(),aa(43,"li"),Qa(44,"Level 3: Protect Controlled Unclassified Information (CUI)"),ca(),aa(45,"li"),Qa(46,"Levels 4-5: Protect CUI and reduce risk of Advanced Persistent Threats (APTs)"),ca(),ca(),ca(),la(47,"img",6),aa(48,"div",7),Qa(49,"Figure 1: CMMC Levels and Associated Focus Areas"),ca(),aa(50,"div",2),aa(51,"h5"),Qa(52,"Level 1"),ca(),aa(53,"p"),Qa(54," Level 1 safeguards Federal Contract Information (FCI). Level 1 encompasses the basic safeguarding requirements for FCI specified in Federal Acquisition Regulation (FAR) Clause 52.204-21, which defines FCI as: "),ca(),aa(55,"p"),aa(56,"em"),Qa(57,"Information, not intended for public release, that is provided by or generated for the Government under a contract to develop or deliver a product or service to the Government, but not including information provided by the Government to the public (such as on public websites) or simple transactional information, such as necessary to process payments."),ca(),ca(),aa(58,"p"),Qa(59," Department of Defense (DoD) contracts that specify the need for a contractor to process, store, or transmit FCI only require the contractor to comply with CMMC Level 1 practices. There is no CMMC process maturity assessed at Level 1. "),ca(),ca(),aa(60,"div",2),aa(61,"h5"),Qa(62,"Level 2"),ca(),aa(63,"p"),Qa(64," Level 2 is a transitional level. At Level 2, a contractor is not yet approved for CUI. CMMC Level 2 practices and processes provide additional safeguarding above CMMC Level 1 and help to prepare a contractor to handle CUI at CMMC Level 3. "),ca(),ca(),aa(65,"div",2),aa(66,"h5"),Qa(67,"Level 3"),ca(),aa(68,"p"),Qa(69," CMMC Level 3 addresses the protection of Controlled Unclassified Information (CUI). The National Archives and Record Administration (NARA) defines CUI as: "),ca(),aa(70,"p"),aa(71,"em"),Qa(72," Information that requires safeguarding or dissemination controls pursuant to and consistent with laws, regulations, and government-wide policies, excluding information that is classified under Executive Order 13526, Classified National Security Information, December 29, 2009, or any predecessor or successor order, or Atomic Energy Act of 1954, as amended."),ca(),ca(),aa(73,"p"),Qa(74," A CMMC Level 3 assessment encompasses the practices and processes of CMMC Levels 1, 2, and 3. CMMC Level 3 shows that a contractor can adequately protect CUI at the appropriate risk level while accounting for subcontractor information flow in a multi-tier supply chain. "),ca(),ca(),aa(75,"div",2),aa(76,"h5"),Qa(77,"Level 4"),ca(),aa(78,"p"),Qa(79," Level 4 provides increased assurance to the DoD that a contractor is capable of protecting CUI while working to reduce the risk of Advanced Persistent Threats and focuses on the protection of CUI from APTs. It encompasses cybersecurity best practices along with enhanced security requirements from NIST SP 800-171B . These practices enhance the detection and response capabilities of an organization to address and adapt to the changing tactics, techniques and procedures (TTPs) used by APTs. "),ca(),ca(),aa(80,"div",2),aa(81,"h5"),Qa(82,"Level 5"),ca(),aa(83,"p"),Qa(84," Level 5 continues the focus on the protection of CUI from APTs and requires a contractor to standardize and optimize process implementation across the organization. "),ca(),ca(),aa(85,"div",2),aa(86,"h4"),Qa(87,"CMMC Practice Questions"),ca(),aa(88,"p"),Qa(89," The CMMC model measures not only process maturity or institutionalization, but also the implementation of practices. The model consists of 171 practices that are mapped across the five levels for all capabilities and domains. This mapping and the cumulative nature of the model is shown in Figure 2 below. "),ca(),ca(),aa(90,"div",2),la(91,"img",8),aa(92,"div",7),Qa(93,"Figure 2: CMMC Levels and Associated Practices"),ca(),ca(),aa(94,"div",2),aa(95,"h4"),Qa(96,"CSET's CMMC Assessment Features"),ca(),aa(97,"h5"),Qa(98,"Note: The guidance below shows screen captures based on the Assessment tab in the Menu Bar selected."),ca(),la(99,"img",9),aa(100,"table",10),aa(101,"tr"),aa(102,"td",11),la(103,"img",12),ca(),aa(104,"td",13),aa(105,"h5"),Qa(106," Tools "),ca(),la(107,"img",14),aa(108,"p"),Qa(109," Selecting the drop-down Tools option expands the menu to show the following options. (For more detail on the Tools Menu options, visit the "),aa(110,"a",15),Qa(111,"CSET User's Guide"),ca(),Qa(112,".)"),ca(),la(113,"img",16),ca(),ca(),aa(114,"tr"),aa(115,"td",11),la(116,"img",17),ca(),aa(117,"td",13),aa(118,"h5"),Qa(119,"Expand / Collapse Sidebar Menu"),ca(),la(120,"img",18),aa(121,"p"),Qa(122," This function expands the Sidebar Menu which includes links to the following assesment features: "),ca(),la(123,"img",19),ca(),ca(),aa(124,"tr"),aa(125,"td",11),la(126,"img",20),ca(),aa(127,"td",13),aa(128,"h5"),Qa(129,"Resource Library"),ca(),la(130,"img",21),aa(131,"p"),Qa(132," The Resource Library offers a collection of CSET's cybersecurity guidance documents and reference materials. "),ca(),ca(),ca(),aa(133,"tr"),aa(134,"td",11),la(135,"img",22),ca(),aa(136,"td",13),aa(137,"h5"),Qa(138,"Prepare Section"),ca(),la(139,"img",23),aa(140,"div"),Qa(141," The Prepare step is the first part of the assessment process and includes the following preparatory pages: "),aa(142,"ul"),aa(143,"li"),Qa(144,"The Assessment Configuration and Assessment Options fields to collect the user's information and assessment selections"),ca(),aa(145,"li"),Qa(146,"The Assessment Information screen where the user's basic demographic information is collected"),ca(),aa(147,"li"),Qa(148,"The remaining screens in the Prepare Step are tailored to the specifics of the user's Assessment Option choice"),ca(),ca(),ca(),ca(),ca(),aa(149,"tr"),aa(150,"td",11),la(151,"img",24),ca(),aa(152,"td",13),aa(153,"h5"),Qa(154,"Assessment Section"),ca(),la(155,"img",25),aa(156,"p"),Qa(157," Depending on whether the user has selected the Maturity Model, Standard, or Network Diagram, this section will display the "),aa(158,"strong"),Qa(159,"Maturity Model"),ca(),Qa(160," selection page or the "),aa(161,"strong"),Qa(162,"Security Assurance Level (SAL)"),ca(),Qa(163," selection page. "),ca(),ca(),ca(),aa(164,"tr"),aa(165,"td",11),la(166,"img",26),ca(),aa(167,"td",13),aa(168,"h5"),Qa(169,"Results"),ca(),la(170,"img",27),aa(171,"p"),Qa(172," The Results section details the various compliance metrics and measurements resulting from a completed assessment."),ca(),aa(173,"p"),Qa(174," The "),aa(175,"strong"),Qa(176,"Reports"),ca(),Qa(177," section is located after the "),aa(178,"strong"),Qa(179,"Results"),ca(),Qa(180," section in the "),aa(181,"strong"),Qa(182,"Sidebar Menu"),ca(),Qa(183,". "),ca(),ca(),ca(),ca(),ca(),aa(184,"div",2),aa(185,"h4"),Qa(186,"CMMC Assessment Steps"),ca(),aa(187,"div"),aa(188,"h5"),Qa(189,"1. Prepare"),ca(),la(190,"img",28),ca(),aa(191,"div",2),Qa(192,"The first step to completing the CMMC practice questions is to set your desired target level. If you are unsure of your target level, see the "),aa(193,"strong"),Qa(194,"CMMC Levels and Focus Areas"),ca(),Qa(195," section above, or check your RFI or RFP documents for the required CMMC compliance level for your contract. "),ca(),aa(196,"div"),la(197,"img",29),ca(),ca(),aa(198,"div",2),aa(199,"h5"),Qa(200,"2. Beginning the assessment "),ca(),aa(201,"div"),la(202,"img",30),ca(),aa(203,"div"),aa(204,"h6"),Qa(205,"Tailoring the Assessment: Filtering Practice Questions and Content on the Screen "),ca(),ca(),aa(206,"div"),Qa(207,"Before starting the assessment, you may wish to tailor the content and questions you interact with."),ca(),aa(208,"div"),Qa(209,"To tailor your assessment, at the top right corner of the Assessment screen, note the "),la(210,"img",31),Qa(211," buttons. "),ca(),aa(212,"div"),la(213,"img",32),ca(),aa(214,"div"),aa(215,"div",33),aa(216,"table"),aa(217,"tr"),aa(218,"td"),aa(219,"div"),la(220,"img",34),aa(221,"div",35),aa(222,"h6"),Qa(223,"Collapse All | Expand All Button"),ca(),ca(),ca(),aa(224,"div",36),la(225,"img",37),ca(),aa(226,"div"),Qa(227,"While in the "),aa(228,"strong"),Qa(229,"Assessment Section"),ca(),Qa(230," of CMMC, users can click the the "),aa(231,"strong"),Qa(232,"Collapse/Expand All "),la(233,"img",38),ca(),Qa(234," buttons at the top right of the screen to adjust the amount of practice questions content on the page. "),ca(),ca(),ca(),ca(),ca(),ca(),aa(235,"div"),aa(236,"div",33),aa(237,"table"),aa(238,"tr"),aa(239,"td"),aa(240,"div"),la(241,"img",39),aa(242,"div",35),aa(243,"h6"),Qa(244,"Questions Filter"),ca(),ca(),ca(),aa(245,"div",36),la(246,"img",40),ca(),aa(247,"div"),Qa(248,"The "),aa(249,"strong"),Qa(250,"Questions Filter"),ca(),Qa(251," helps further tailor the types of content users interact with during the assessment. "),ca(),ca(),ca(),ca(),ca(),ca(),aa(252,"div"),aa(253,"h6"),Qa(254,"To View all CMMC Level Practice Questions Regardless of Target Level"),ca(),ca(),aa(255,"div"),Qa(256,"In the Questions Filter pop-up screen (below) users can select the option to view questions above their set target level during the assessment. This will not affect the assessment target level scoring. Any additional questions answered beyond the user's selected target level will be shaded gray on the reports and not calculated in the final maturity score."),ca(),aa(257,"div"),aa(258,"h6"),Qa(259,"Questions Filter Pop-Up "),ca(),ca(),aa(260,"div"),Qa(261,"Select and de-select the checkboxes to tailor your practice questions throughout the assessment process. When you have finished the assessment, this feature is also useful during review."),ca(),aa(262,"div"),la(263,"img",41),ca(),ca(),aa(264,"div",2),aa(265,"h5"),Qa(266,"3. Navigating the Assessment"),ca(),aa(267,"h6"),Qa(268,"CMMC Practice Question Layout"),ca(),aa(269,"div"),la(270,"img",42),ca(),aa(271,"div"),aa(272,"div",33),aa(273,"table"),aa(274,"tr"),aa(275,"td"),aa(276,"div"),la(277,"img",43),aa(278,"div",35),aa(279,"h6"),Qa(280,"Domain and Domain Acronym"),ca(),ca(),ca(),aa(281,"div",36),la(282,"img",44),ca(),aa(283,"div"),Qa(284,"The CMMC model consists of 17 domains. The majority of these domains originate from the security-related areas in Federal Information Processing Standards (FIPS) Publication 200 and the related security requirement families from NIST SP 800-171. The CMMC model also includes the three domains of Asset Management (AM), Recovery (RE), and Situational Awareness (SA)."),ca(),ca(),ca(),ca(),ca(),ca(),aa(285,"div"),aa(286,"div",33),aa(287,"table"),aa(288,"tr"),aa(289,"td"),aa(290,"div"),la(291,"img",45),aa(292,"div",35),aa(293,"h6"),Qa(294,"Practice Identifier"),ca(),ca(),ca(),aa(295,"div",36),aa(296,"strong"),Qa(297,"AC.1.0001"),ca(),ca(),aa(298,"div"),Qa(299,"Each CMMC practice is specified using the convention of "),aa(300,"strong"),Qa(301,"[DOMAIN].[LEVEL].[PRACTICE NUMBER]"),ca(),ca(),ca(),ca(),ca(),ca(),ca(),aa(302,"div"),aa(303,"div",33),aa(304,"table"),aa(305,"tr"),aa(306,"td"),aa(307,"div"),la(308,"img",46),aa(309,"div",35),aa(310,"h6"),Qa(311,"Capability"),ca(),ca(),ca(),aa(312,"div",36),la(313,"img",47),ca(),aa(314,"div"),Qa(315,"There are 43 capabilities associated with the 17 domains in the CMMC model."),ca(),ca(),ca(),ca(),ca(),ca(),aa(316,"div"),aa(317,"div",33),aa(318,"table"),aa(319,"tr"),aa(320,"td"),aa(321,"div"),la(322,"img",48),aa(323,"div",35),aa(324,"h6"),Qa(325,"Level Indicator"),ca(),ca(),ca(),aa(326,"div",36),la(327,"img",49),ca(),aa(328,"div"),Qa(329,"Indicates the corresponding level associated with the practice statement. CMMC provides a benchmark against which an organization can evaluate the current "),aa(330,"strong"),Qa(331,"level"),ca(),Qa(332," of capability of its processes, practices, and methods and set goals and priorities for improvement. "),ca(),aa(333,"div"),aa(334,"span",50),Qa(335,"The CMMC assessment process provides consistent guidance for assessing a contractor against specific CMMC "),aa(336,"strong"),Qa(337,"Levels 1-5."),ca(),ca(),ca(),ca(),ca(),ca(),ca(),ca(),aa(338,"div"),aa(339,"div",33),aa(340,"table"),aa(341,"tr"),aa(342,"td"),aa(343,"div"),la(344,"img",51),aa(345,"div",35),aa(346,"h6"),Qa(347,"CSET Icons"),ca(),ca(),ca(),aa(348,"div",36),la(349,"img",52),ca(),aa(350,"div",36),Qa(351,"In the "),aa(352,"strong"),Qa(353,"CSET Icons"),ca(),Qa(354," section below, you will find a breakdown of each of the CSET-specific icons and how they help facilitate a CMMC assessment. "),ca(),ca(),ca(),ca(),ca(),ca(),aa(355,"div"),aa(356,"div",33),aa(357,"table"),aa(358,"tr"),aa(359,"td"),aa(360,"div"),la(361,"img",53),aa(362,"div",35),aa(363,"h6"),Qa(364,"Practice Statement"),ca(),ca(),ca(),aa(365,"div",36),la(366,"img",54),ca(),aa(367,"div"),Qa(368,"The CMMC model consists of 171 practices that are mapped across the five levels for all capabilities and domains. This mapping and the cumulative nature of the model is shown in Figure."),ca(),ca(),ca(),ca(),ca(),ca(),aa(369,"div"),aa(370,"div",33),aa(371,"table"),aa(372,"tr"),aa(373,"td"),aa(374,"div"),la(375,"img",55),aa(376,"div",35),aa(377,"h6"),Qa(378,"Assessment Findings (CSET Answer Key)"),ca(),ca(),ca(),aa(379,"div",36),la(380,"img",56),ca(),aa(381,"div",36),Qa(382,"A full breakdown of the CMMC Assessment Findings (CSET Answer Key) is below."),ca(),ca(),ca(),ca(),ca(),ca(),aa(383,"div"),aa(384,"div",33),aa(385,"table"),aa(386,"tr"),aa(387,"td"),aa(388,"div"),la(389,"img",57),aa(390,"div",35),aa(391,"h6"),Qa(392,"Progress Indicator"),ca(),ca(),ca(),aa(393,"div",36),la(394,"img",58),ca(),aa(395,"div",36),Qa(396,"The Progress Indicator will turn blue and complete the circle as the questions in each Capability area are completed. When all the questions are complete, the Progress Indicator will show a check mark. "),ca(),ca(),ca(),ca(),ca(),ca(),aa(397,"div"),aa(398,"h6"),Qa(399,"CMMC Practice Identifiers "),ca(),ca(),aa(400,"div"),la(401,"img",59),Qa(402,"\xa0 Each practice is specified using the convention of "),aa(403,"strong"),Qa(404,"[DOMAIN].[LEVEL].[PRACTICE NUMBER]"),ca(),Qa(405," above the applicable "),aa(406,"strong"),Qa(407,"level number"),ca(),Qa(408," for the practice."),ca(),aa(409,"ul"),aa(410,"li"),aa(411,"strong"),Qa(412,"DOMAIN"),ca(),Qa(413," is the two letter domain abbreviation;"),ca(),aa(414,"li"),aa(415,"strong"),Qa(416,"LEVEL"),ca(),Qa(417," is the level number; and"),ca(),aa(418,"li"),aa(419,"strong"),Qa(420,"PRACTICE NUMBER"),ca(),Qa(421," is the identifier assigned to that practice."),ca(),aa(422,"li"),aa(423,"strong"),Qa(424,"Level 1, 2, 3, 4, or 5."),ca(),ca(),ca(),aa(425,"div"),aa(426,"h6"),Qa(427,"CSET Answer Key for CMMC"),ca(),ca(),aa(428,"div"),la(429,"img",60),ca(),ca(),aa(430,"div",2),aa(431,"h5"),Qa(432,"4. Answering the Practice Questions"),ca(),aa(433,"div"),la(434,"img",61),aa(435,"span",62),aa(436,"strong"),Qa(437," MET"),ca(),ca(),Qa(438," is presented as "),aa(439,"strong"),Qa(440,"Yes"),ca(),Qa(441," in the CSET "),aa(442,"span",62),Qa(443,"Assessment "),ca(),Qa(444,"Tool"),aa(445,"span",62),Qa(446,". The contractor successfully meets the practice. For "),ca(),ca(),aa(447,"div"),aa(448,"span",62),Qa(449,"each practice marked MET, the assessor includes statements that indicate the response conforms to the objectives and documents the appropriate evidence to support the response. "),ca(),ca(),aa(450,"div"),aa(451,"span",62),Qa(452,"For "),aa(453,"strong"),Qa(454,"MET (Yes)"),ca(),Qa(455,", the assessor can use the "),aa(456,"strong"),Qa(457,"Observations"),ca(),Qa(458," field to record applicable observations."),ca(),ca(),aa(459,"div"),la(460,"img",63),ca(),aa(461,"div"),la(462,"img",64),aa(463,"span",62),aa(464,"strong"),Qa(465," NOT MET"),ca(),Qa(466," is presented as "),aa(467,"strong"),Qa(468,"NO"),ca(),Qa(469," in the CSET Assessment tool. The contractor has not met the practice. For each practice marked NOT MET, the assessor includes statements that explain why and documents the appropriate evidence that the contractor does not conform to the objectives."),ca(),ca(),aa(470,"div"),aa(471,"span",62),Qa(472,"For "),aa(473,"strong"),Qa(474,"NOT MET"),ca(),aa(475,"strong"),Qa(476,"(No)"),ca(),Qa(477,", the assessor can use the "),aa(478,"strong"),Qa(479,"Observations"),ca(),Qa(480," field to record applicable observations."),ca(),ca(),aa(481,"div"),la(482,"img",65),ca(),aa(483,"div"),aa(484,"span",62),Qa(485,"\xa0"),ca(),ca(),aa(486,"div"),aa(487,"h6"),Qa(488,"Inherited Practice Objectives - MET"),ca(),ca(),aa(489,"div"),aa(490,"span",62),Qa(491,"Note: A contractor can inherit practice objectives. A practice objective that is inherited is met because adequate evidence is provided that the enterprise or another entity, such as an External Service Provider (ESP), performs the practice objective. Evidence from the enterprise or the entity from which the objectives are inherited should show they are applicable to in-scope assets and that the assessment objectives are met. For each practice objective that is inherited, the assessor includes statements that indicate how they were evaluated and from whom they are inherited. If the contractor cannot demonstrate adequate evidence for all assessment objectives, through either contractor evidence or evidence of inheritance, the contractor will receive a NOT MET for the practice."),ca(),ca(),aa(492,"div"),la(493,"img",66),aa(494,"span",62),aa(495,"strong"),Qa(496,"\xa0 NOT APPLICABLE"),ca(),ca(),Qa(497,"is presented as "),aa(498,"strong"),Qa(499,"ALT"),ca(),Qa(500," n the CSET "),aa(501,"span",62),Qa(502,"Assessment "),ca(),Qa(503,"Tool"),aa(504,"span",62),Qa(505,". ALT indicates the practice does not apply for the assessment. For each practice marked ALT, the assessor is required to include a statement that explains why the practicedoes not apply to the contractor.\xa0 "),ca(),ca(),aa(506,"div"),aa(507,"span",62),Qa(508,"Assessor comments can be recorded in the pop-up alternate justification text box beneath the question."),ca(),ca(),aa(509,"div"),la(510,"img",67),ca(),aa(511,"div");aa(512,"h6"),Qa(513,"Mark for Review"),ca(),ca(),aa(514,"div"),aa(515,"span",62),Qa(516,'The mark for review function allows a user to indicate that a practice question requires further review. Marked practices are listed in the "Comments and Marked for Review CMMC" report. In this section of the CSET Report Page (left side navigation "Reports"), the user can locate comments specific to each practice question and recall any practices that were marked for review. '),ca(),ca(),aa(517,"div"),la(518,"img",68),ca(),aa(519,"div"),aa(520,"h6"),Qa(521,"Supplemental Guidance"),ca(),ca(),aa(522,"div"),aa(523,"span",62),Qa(524,"Users can refer to the supporting authorities and additional guidance provided under "),aa(525,"strong"),Qa(526,"Supplemental Guidance"),ca(),Qa(527,". "),ca(),ca(),aa(528,"div"),aa(529,"span",62),Qa(530,"Many of these documents can be found in the "),ca(),aa(531,"a",69),Qa(532,"CSET Resource Library."),ca(),ca(),aa(533,"div"),la(534,"img",70),ca(),aa(535,"div"),aa(536,"h6"),Qa(537,"Comments "),ca(),ca(),aa(538,"div",71),Qa(539,'The comments function allows the assessor to record non-structured comments for each question during the assessment. Practices with comments are listed in the "Comments and Marked for Review CMMC" report. In this section of the CSET Report Page (left side navigation "Reports"), the user can locate comments specific to each practice question and recall any practices that were marked for review. '),ca(),aa(540,"div"),Qa(541," In contrast, the Observations function (also useful for commenting) is more rigid and contains required fields. "),ca(),aa(542,"div"),la(543,"img",72),ca(),aa(544,"div",73),aa(545,"h6"),Qa(546,"Artifacts/Documents "),ca(),ca(),aa(547,"div"),Qa(548,"Assessors can use the Artifacts/Documents function to attach relevant evidence to each practice question. "),ca(),aa(549,"div"),la(550,"img",74),ca(),aa(551,"div"),Qa(552,"The documents will appear listed by file name beneath the question when attached. A red indicator will appear on the icon for each question where evidence has been attached."),ca(),aa(553,"div"),la(554,"img",75),ca(),aa(555,"div"),aa(556,"span",62),Qa(557,"Access your attached documents, artifacts, and evidence under the "),la(558,"img",76),Qa(559," Tools Menu next to the CSET Logo on the upper left side of the screen. "),ca(),ca(),aa(560,"div"),la(561,"img",77),ca(),aa(562,"div"),aa(563,"span",62),Qa(564,"The Assessment Documents tab will open up a pop-up window showing all documents that are attached to the Assessment. Documents are organized by title."),ca(),ca(),aa(565,"div"),la(566,"img",78),ca(),aa(567,"div"),aa(568,"h6"),Qa(569,"References "),ca(),ca(),aa(570,"div"),aa(571,"span",62),Qa(572,"Users can click on the "),aa(573,"strong"),Qa(574,"References"),ca(),Qa(575," icon to open links to CMMC .pdf documentation and to access CMMC assessment help documents, Errata, and the Glossary/Acronyms document. Documents will open in a separate window."),ca(),ca(),aa(576,"div",73),la(577,"img",79),ca(),aa(578,"div"),aa(579,"h6"),Qa(580,"Observations "),ca(),ca(),aa(581,"div"),Qa(582,"The Observations Icon opens a pop-up window that allows an assessor to record their observations for each practice question. "),ca(),aa(583,"div"),la(584,"img",80),ca(),aa(585,"div"),Qa(586,"Once a user has entered their observations, a red indicator highlights the icon and the observations are listed beneath the practice question in order of entry. "),ca(),aa(587,"div",73),la(588,"img",81),ca(),aa(589,"div"),aa(590,"h6"),Qa(591,"Observations Details Pop-Up Screen:"),ca(),ca(),aa(592,"div"),Qa(593,"After selecting the Observations Icon, the Observations Details screen appears."),ca(),aa(594,"div",73),la(595,"img",82),ca(),aa(596,"div"),aa(597,"h6"),Qa(598,"Feedback"),ca(),ca(),aa(599,"div"),Qa(600,"Users can record Feedback during the assessment for submission to CSET/DHS. Some examples of submitted feedback include commentary on the subject matter of the question, the structure of the question, and how the question and layout can be improved. "),ca(),aa(601,"div",73),la(602,"img",83),ca(),ca(),aa(603,"div",2),aa(604,"h5"),Qa(605,"5. CMMC Results and Report"),ca(),la(606,"img",84),aa(607,"p"),Qa(608,"The primary deliverable of a CMMC assessment is the CMMC Site Report which contains the findings associated with the assessment. To learn more about the CMMC Results and Report functionality, visit the "),aa(609,"a",85),Qa(610,"Results"),ca(),Qa(611," and "),aa(612,"a",86),Qa(613,"Reports"),ca(),Qa(614," section of the CMMC User Guide. "),ca(),ca(),aa(615,"div",2),aa(616,"h5"),Qa(617,"6. Submit Feedback"),ca(),aa(618,"p"),Qa(619," At the end of the assessment, users are prompted to submit their feedback on the CSET Assessment."),ca(),la(620,"img",87),ca(),la(621,"app-nav-back-next",88),ca()}2&n&&(xr(621),ra("page","tutorial-cmmc"))},directives:[YI],styles:[""]}),$xn),nvn=((Qxn=function(){function n(){b(this,n)}return h(n,[{key:"ngOnInit",value:function(){}}]),n}()).\u0275fac=function(n){return new(n||Qxn)},Qxn.\u0275cmp=dn({type:Qxn,selectors:[["app-tutorial-edm"]],decls:277,vars:1,consts:[[1,"white-panel","d-flex","justify-content-start","flex-column","flex-11a","tutorial"],[1,"wrap-text","mb-3"],[1,"mb-4"],[1,"mb-5"],[1,"cset-table"],[1,"text-right"],[1,"image-caption"],["src","assets/images/EDM/tutorial/image001.png","alt","Practice Questions Answer Choice Icons: Yes, No, Incomplete"],["src","assets/images/EDM/tutorial/image002.png","alt","Mark for Review Icon",1,"image-center",2,"float","left","vertical-align","top"],[1,"mt-2"],[1,"mb-3"],["src","assets/images/EDM/tutorial/image003.jpg","alt","Figure one shows the practice question layout.",1,"image-center"],["src","assets/images/EDM/tutorial/image004.jpg","alt","Guidance Icon"],["src","assets/images/EDM/tutorial/image005.jpg","alt","Comments Icon"],["src","assets/images/EDM/tutorial/image006.jpg","alt","Artifacts References Icon"],["src","assets/images/EDM/tutorial/image007.jpg","alt","References Icon"],["src","assets/images/EDM/tutorial/image008.jpg","alt","Observations Icon"],["src","assets/images/EDM/tutorial/image009.jpg","alt","Feedback Icon"],["src","assets/images/EDM/tutorial/image010.png","alt","Figure 2 shows the glossary definition pop-up embedded in the practice question text. ",1,"image-center"],["src","assets/images/EDM/tutorial/image011.png","alt","Figure 3 shows the Domain Remarks text box located at the end of each domain.",1,"image-center"],["src","assets/images/EDM/tutorial/image012.jpg","alt","Figure 4 shows an example of Asset Types.",1,"image-center"],["src","assets/images/EDM/tutorial/image013.jpg","alt","Figure 5 shows an example of the external entity types.",1,"image-center"],[1,"my-4"],[3,"page"]],template:function(n,t){1&n&&(aa(0,"div",0),aa(1,"h3",1),Qa(2,"EDM Tutorial"),ca(),aa(3,"div",2),aa(4,"h5"),Qa(5,"Overview"),ca(),aa(6,"p"),Qa(7,"The EDM Assessment focuses on practices to manage risks associated with external dependencies, especially risks related to information and communications technology (ICT). This type of risk\u2014also commonly called supply chain or third-party risk\u2014is of particular concern to many organizations, which increasingly have a large number of external dependencies. Organizations face inherent uncertainty in managing complex, rapidly changing, arms-length relationships involving technology. They also face a threat environment that exacerbates these concerns. The EDM Assessment helps by providing an efficient, effective way to measure and report on an organization's capability to manage this risk. The EDM Assessment also incorporates and expands on the cybersecurity concepts included in the National Institute of Standards and Technology (NIST) Cybersecurity Framework (CSF). As part of this instrument\u2019s capability, the EDM results are also depicted in terms of the NIST CSF."),ca(),aa(8,"p"),Qa(9,"External dependencies exist when external entities have defined obligations or relationships with assets or services that your organization requires to support its business objectives and mission. Examples include third parties that provide, operate, control, have access to, own, or have other responsibilities over key ICT and related assets."),ca(),ca(),aa(10,"div",2),aa(11,"h5"),Qa(12,"The EDM Assessment"),ca(),aa(13,"p"),Qa(14,"The EDM Assessment consists of a structured interview of key personnel which takes about a half-day to complete. Its goal is to measure and report on an organization's cybersecurity practices as they relate to managing external dependencies and their associated risks."),ca(),aa(15,"p"),Qa(16,"The EDM Assessment reflects an organization\u2019s capabilities at a single point in time\u2014at the time of the assessment."),ca(),aa(17,"p"),Qa(18,"The assessment does not consider:"),ca(),aa(19,"ul"),aa(20,"li"),Qa(21,"activities that are planned or are in the process of implementation "),ca(),aa(22,"li"),Qa(23,"practices that have not been performed for extended periods. For example, if the organization has a disaster recovery plan that, in the opinion of the participants, is out of date to the point of being unusable, the plan should not be considered. "),ca(),ca(),ca(),aa(24,"div",2),aa(25,"h5"),Qa(26,"External Entity Services "),ca(),aa(27,"p"),Qa(28,"Examples of dependencies include external entities that provide:"),ca(),aa(29,"ul"),aa(30,"li"),Qa(31," services that explicitly involve the operation, maintenance, or provisioning of ICT for the organization. Examples of these services include cloud services, data hosting, on-site maintenance services, and the operation of control systems to support the organization. "),ca(),aa(32,"li"),Qa(33," services supported by ICT, including any type of service that is appreciably supported through the use of information and communications technology. In the financial sector, examples may include the printing of account statements by the subcontractor to a banking institution. "),ca(),aa(34,"li"),Qa(35," governmental services, such as fire and police response to protect data centers. "),ca(),aa(36,"li"),Qa(37," infrastructure services such as electricity, telecommunications networks, or transportation assets. "),ca(),aa(38,"li"),Qa(39," technology products and services such as hardware and software that is utilized by the organization to provided services to its customers. "),ca(),ca(),ca(),aa(40,"div",2),aa(41,"h5"),Qa(42,"External Entity Types"),ca(),aa(43,"p"),Qa(44,"To comprehensively measure the EDM capability of the organization and ensure completeness, several questions are asked about practices performed for different types of external entities. The external entity types used are: "),ca(),aa(45,"ul"),aa(46,"li"),aa(47,"strong"),Qa(48,"Supplier"),ca(),Qa(49," - external entities that provide ICT-related goods and services and with which the acquirer has some ability to negotiate. These entities may also be called subcontractors or vendors. Depending on scoping and the needs of the organization, this category may also apply to supporting affiliates or separate business units of the larger enterprise. Examples of these suppliers include centrally managed IT or other business services. These relationships are sometimes governed by Operational Level Agreements. "),ca(),aa(50,"li"),aa(51,"strong"),Qa(52,"Governmental services"),ca(),Qa(53," - services provided by a governmental department or agency. These services frequently involve security; for example, fire, police, and emergency response. "),ca(),aa(54,"li"),aa(55,"strong"),Qa(56,"Infrastructure providers"),ca(),Qa(57," - supplies goods or services to a region, economy, infrastructure sector, or political subdivision; however, the acquirer normally has no commercially practical ability to negotiate with this type of supplier. Examples of infrastructure providers include water, power, or transportation. "),ca(),ca(),ca(),aa(58,"div",2),aa(59,"h5"),Qa(60,"Critical Service Scope"),ca(),aa(61,"p"),Qa(62,"The EDM Assessment has a service orientation, meaning that it is intended to assess the organization's management of external dependencies relative to a specific critical service."),ca(),aa(63,"p"),Qa(64,"A critical service must be selected and is defined as:"),ca(),aa(65,"p"),Qa(66,"A set of activities an organization carries out in the performance of a duty or in the production of a product that is so critical to the organization's success that its disruption would severely impact continued operations or success in meeting the organization's mission."),ca(),aa(67,"p"),Qa(68,"Organizations typically have a set of critical services that define their mission. The selection of a critical service for assessment\u2014rather than assessing the organization as a whole\u2014helps to scope the assessment and tie the results to the organization's mission."),ca(),aa(69,"p"),Qa(70,"Below are some examples of organizations and their typical critical services that might be selected as part of an EDM Assessment:"),ca(),aa(71,"ul"),aa(72,"li"),Qa(73,"banks and other financial institutions: clearing and settlement, mortgage application processing"),ca(),aa(74,"li"),Qa(75,"emergency services providers: processing 911 calls, dispatch"),ca(),aa(76,"li"),Qa(77,"electrical power plants: electricity generation, electricity distribution"),ca(),aa(78,"li"),Qa(79,"hospitals: clinical services, prescription management"),ca(),aa(80,"li"),Qa(81,"government agencies: court case management, benefit management"),ca(),aa(82,"li"),Qa(83,"manufacturing companies: machining operations, order processing"),ca(),aa(84,"li"),Qa(85,"airports: air traffic control, fuel management"),ca(),ca(),ca(),aa(86,"div",3),aa(87,"h5"),Qa(88,"EDM Assessment Architecture and Structure"),ca(),aa(89,"p"),Qa(90,"The following table details the domains of the EDM Assessment. Each domain represents important capabilities that contribute to managing external dependencies across the lifecycle of the relationships with external organizations. "),ca(),aa(91,"table",4),aa(92,"tr"),aa(93,"th"),Qa(94,"EDM Assessment Domain"),ca(),aa(95,"th",5),Qa(96,"No. of Goals"),ca(),aa(97,"th",5),Qa(98,"No. of Goal Practices"),ca(),ca(),aa(99,"tr"),aa(100,"td"),Qa(101," Relationship Formation "),ca(),aa(102,"td",5),Qa(103,"6"),ca(),aa(104,"td",5),Qa(105,"26"),ca(),ca(),aa(106,"tr"),aa(107,"td"),Qa(108,"Relationship Management and Governance"),ca(),aa(109,"td",5),Qa(110,"7"),ca(),aa(111,"td",5),Qa(112,"30"),ca(),ca(),aa(113,"tr"),aa(114,"td"),Qa(115,"Service Protection and Sustainment"),ca(),aa(116,"td",5),Qa(117,"3"),ca(),aa(118,"td",5),Qa(119,"15"),ca(),ca(),aa(120,"tr"),aa(121,"td"),Qa(122," MIL Practices "),ca(),aa(123,"td",5),Qa(124,"4"),ca(),aa(125,"td",5),Qa(126,"15"),ca(),ca(),ca(),aa(127,"div",6),Qa(128,"Table 1: EDM Assessment Domain Composition: Number of Goals and Goal Practices "),ca(),ca(),aa(129,"div",2),aa(130,"h5"),Qa(131,"Practice Questions Structure"),ca(),aa(132,"p"),Qa(133,"Each practice question contains a 3-point response scale to evaluate the degree to which the organization has implemented each practice.\xa0 Each question has three possible answers: \u201cYes\u201d, \u201cIncomplete\u201d, and \u201cNo\u201d: "),ca(),la(134,"img",7),aa(135,"ul"),aa(136,"li"),aa(137,"strong"),Qa(138,"Yes"),ca(),Qa(139," \u2013 the organization fully performs the activity specified in the question."),ca(),aa(140,"li"),aa(141,"strong"),Qa(142,"Incomplete"),ca(),Qa(143," \u2013 the organization partially performs the activity"),ca(),aa(144,"li"),aa(145,"strong"),Qa(146,"No"),ca(),Qa(147," \u2013 the organization does not perform the activity at all."),ca(),ca(),aa(148,"p"),la(149,"img",8),aa(150,"span",9),aa(151,"strong"),Qa(152,"Mark for Review"),ca(),Qa(153,': To the right of the three-point response scale is the flag icon which can be used to mark a practice for review. Marked questions are listed in the "EDM Comments and Marked For Review" report. In this section of the CSET Report Page (left side navigation \u201cReports\u201d), the user can locate comments specific to each practice question and recall any practices previously marked for review. '),ca(),ca(),aa(154,"div",10),la(155,"img",11),aa(156,"div",6),Qa(157,"Figure 1: Practice Question Layout"),ca(),ca(),aa(158,"p"),la(159,"img",12),aa(160,"strong"),Qa(161,"Supplemental Guidance"),ca(),Qa(162,": To aid the facilitator, each question is supported by guidance.\xa0 The guidance should be referred to for background, possible examples and artifacts, and for criteria that defines the requirements for a \u201cYes\u201d and an \u201cIncomplete\u201d answer.\xa0 The guidance is engaged by selecting the Guidance Icon containing the letter \u201cG\u201d located below the question. "),ca(),aa(163,"p"),la(164,"img",13),aa(165,"strong"),Qa(166,"Comments"),ca(),Qa(167,": Selecting this icon will display a text box that may be used to make comments regarding each question. For example, the facilitator of an assessment may make a note for future reference as to the reasoning behind an \u201cincomplete\u201d response. Note: these comments are not included in the official report and are meant to be private to the facilitator. "),ca(),aa(168,"p"),Qa(169," Practices with comments are listed in the \u201cEDM Comments and Marked for Review\u201d report. In this section of the CSET Report Page (left side navigation \u201cReports\u201d), the user can locate comments specific to each practice question made during the assessment and recall any practices previously marked for review. "),ca(),aa(170,"p"),la(171,"img",14),aa(172,"strong"),Qa(173,"Artifacts/Documents"),ca(),Qa(174,": Easily associate, track, and store evidence, artifacts, and other supporting documents throughout the assessment."),ca(),aa(175,"p"),la(176,"img",15),aa(177,"strong"),Qa(178,"References"),ca(),Qa(179,": Selecting the References Icon will display the Options for Consideration associated with the particular question.\xa0 The Options for Consideration are normally found in the report but are also made available to the facilitator while performing the assessment.\xa0 These options outline general guidelines or activities and the associated sources that can be used to improve the external dependencies management and the resilience of the critical service assessed."),ca(),aa(180,"p"),la(181,"img",16),aa(182,"strong"),Qa(183,"Observations"),ca(),Qa(184,": Selecting this icon will pop up an observation details dialog box used to capture information about an issue associated with the particular practice along with its importance, resolution date, etc."),ca(),aa(185,"p"),la(186,"img",17),aa(187,"strong"),Qa(188,"Feedback"),ca(),Qa(189,": Used to provide feedback regarding the question to CISA.\xa0 For example, a user may comment that the question language is too complex and suggest alternate wording. "),ca(),ca(),aa(190,"div",2),aa(191,"h5"),Qa(192,"Glossary Definitions"),ca(),aa(193,"p"),Qa(194,"A question may contain context-sensitive help for certain terms.\xa0 This can be accessed by hovering over the term that is underlined with a series of dots. "),ca(),aa(195,"div",10),la(196,"img",18),aa(197,"div",6),Qa(198," Figure 2: Glossary Definition Pop-Up "),ca(),ca(),aa(199,"div",2),aa(200,"p"),Qa(201,"At the end of each domain, a Domain Remarks text box is available to the user.\xa0 Any text entered in this box is copied verbatim into the report. It can be used to capture information such as reasoning or organization-specific information.\xa0 For example, if an improvement effort is already underway to address some of the practices in a particular domain, it can be detailed here to make it part of the official report.\xa0 "),aa(202,"b"),Qa(203,"Since this text is copied verbatim into the report a user should use discretion in their commentary."),ca(),Qa(204,"\xa0 "),ca(),aa(205,"div",10),la(206,"img",19),aa(207,"div",6),Qa(208," Figure 3: Domain Remarks Text Box "),ca(),ca(),ca(),aa(209,"div",2),aa(210,"h5"),Qa(211,"Asset Types"),ca(),aa(212,"p"),Qa(213,"To support the accuracy and completeness of the assessment, several questions involve specific practices for each type of asset. These asset types are:"),ca(),aa(214,"ul"),aa(215,"li"),Qa(216,"People - the staff that support data centers or otherwise use information and communications technology to deliver the service"),ca(),aa(217,"li"),Qa(218,"Information - account information, technology asset configuration files, and personal health information"),ca(),aa(219,"li"),Qa(220,"Technology - computers, software, and control systems"),ca(),aa(221,"li"),Qa(222,"Facilities - offices or data centers supporting the delivery of the service"),ca(),ca(),aa(223,"p"),Qa(224,"Some questions require a separate answer for each of the four assets while other questions refer to all assets.\xa0 See the example directly below."),ca(),aa(225,"div",2),la(226,"img",20),aa(227,"div",6),Qa(228,"Figure 4: Asset Types"),ca(),ca(),ca(),aa(229,"div",2),aa(230,"h5"),Qa(231,"External Entity Types"),ca(),aa(232,"p"),Qa(233,"As described above there are three types of external entities that the EDM assessment addresses.\xa0 To ensure completeness, several questions ask about practices performed for different types of external entities.\xa0 See the example below."),ca(),aa(234,"div",10),la(235,"img",21),aa(236,"div",6),Qa(237,"Figure 5: External Entity Types"),ca(),ca(),ca(),aa(238,"div",2),aa(239,"h5"),Qa(240,"Maturity Indicator Levels"),ca(),aa(241,"p"),Qa(242,"The EDM Assessment utilizes one standard set of Maturity Indicator Level (MIL) questions. The MIL questions examine the institutionalization of EDM practices within an organization.\xa0 Institutionalization means that cybersecurity practices become a deeper, more lasting part of the organization because they are managed and supported in meaningful ways. When cybersecurity practices become more institutionalized\u2014or \u201cembedded\u201d\u2014managers can have more confidence in the practices\u2019 predictability and reliability. Institutionalized practices are also more likely to be sustained during times of disruption or stress to the organization."),ca(),aa(243,"p"),Qa(244,"A Maturity Indicator Level (MIL) is assigned to the organization's External Dependencies Management capability. It represents a consolidated view of performance.\xa0 The EDM Assessment uses one maturity scale for all three domains because the domains represent different parts of the lifecycle.\xa0 "),ca(),aa(245,"p"),Qa(246,"The MIL scale itself uses six maturity levels, each with rigorous, defined components:"),ca(),aa(247,"div",22),aa(248,"h6"),Qa(249,"MIL0 Incomplete -> MIL1 Performed -> MIL2 Planned -> MIL3 Managed -> MIL4 Measured -> MIL5 Defined"),ca(),ca(),aa(250,"h6"),Qa(251,"MIL0 Incomplete"),ca(),aa(252,"p"),Qa(253,"All practices in the domain are not being fully performed as measured by responses to the relevant EDM Assessment questions in the domain."),ca(),aa(254,"h6"),Qa(255,"MIL1 Performed"),ca(),aa(256,"p"),Qa(257,"All practices that support the goals in a domain are being performed as measured by responses to the relevant EDM Assessment questions."),ca(),aa(258,"h6"),Qa(259,"MIL2 Planned"),ca(),aa(260,"p"),Qa(261,"A specific practice in the EDM Assessment domain is not only performed but is also supported by planning, policy, stakeholders, and relevant standards and guidelines."),ca(),aa(262,"h6"),Qa(263,"MIL3 Managed"),ca(),aa(264,"p"),Qa(265,"All practices in a domain are performed, planned, and have the basic governance infrastructure in place, are appropriately staffed, adequately funded, and managed for risk."),ca(),aa(266,"h6"),Qa(267,"MIL4 Measured"),ca(),aa(268,"p"),Qa(269,"All practices in a domain are performed, planned, managed, monitored, and controlled. A measured process or practice is periodically evaluated for effectiveness, evaluated against its practice description and plan, and periodically reviewed with higher-level management."),ca(),aa(270,"h6"),Qa(271,"MIL5 Defined"),ca(),aa(272,"p"),Qa(273,"All practices in a domain are performed, planned, managed, measured, and consistent across all constituencies within an organization that have a vested interest in the performance of the practice. At MIL5, a process or practice is defined by the organization and tailored by individual operating units and supported by improvement information that is collected by and shared among operating units for the overall benefit of the organization."),ca(),aa(274,"p"),Qa(275,"In the above progression, an organization can only attain a given MIL if it has attained all lower MILs. In other words, an organization that fails to perform all of the cybersecurity practices at MIL1 in a domain would also fail to reach MIL2 in that domain, even if it would have satisfied all the requirements at MIL2. "),ca(),ca(),la(276,"app-nav-back-next",23),ca(),ca()),2&n&&(xr(276),ra("page","tutorial-edm"))},directives:[YI],encapsulation:2}),Qxn);function tvn(n,t){if(1&n&&(aa(0,"div"),aa(1,"div",30),aa(2,"div",24),aa(3,"div",25),aa(4,"h1",31),Qa(5),ca(),ca(),aa(6,"div",27),aa(7,"div",28),Qa(8),ca(),ca(),ca(),aa(9,"div",14),aa(10,"table",32),aa(11,"tbody"),aa(12,"tr",33),aa(13,"td"),la(14,"app-charts-donut",34),ca(),ca(),ca(),ca(),ca(),ca(),ca()),2&n){var e=t.$implicit,o=Pa(3);xr(5),$a(e.name),xr(2),ra("ngClass",o.acetSvc.maturityClasses(e.AssessedMaturityLevel)),xr(1),$a(o.acetSvc.translateMaturity(e.AssessedMaturityLevel)),xr(6),ra("donutData",e.data)("range",o.matRange)}}function evn(n,t){if(1&n&&(aa(0,"div"),aa(1,"div",24),aa(2,"div",25),aa(3,"h1",29),Qa(4),ca(),ca(),aa(5,"div",27),aa(6,"div",28),Qa(7),ca(),ca(),ca(),ta(8,tvn,15,5,"div",18),ca()),2&n){var e=t.$implicit,o=Pa(2);xr(4),$a(e.asseessmentFactor),xr(2),ra("ngClass",o.acetSvc.maturityClasses(e.domainMaturity)),xr(1),$a(o.acetSvc.translateMaturity(e.domainMaturity)),xr(1),ra("ngForOf",e.sections)}}function ovn(n,t){if(1&n&&(aa(0,"div"),la(1,"hr",16),aa(2,"div",24),aa(3,"div",25),aa(4,"h1",26),Qa(5),ca(),ca(),aa(6,"div",27),aa(7,"div",28),Qa(8),ca(),ca(),ca(),ta(9,evn,9,4,"div",18),ca()),2&n){var e=t.$implicit,o=Pa();xr(5),$a(e.domainName),xr(2),ra("ngClass",o.acetSvc.maturityClasses(e.domainMaturity)),xr(1),$a(o.acetSvc.translateMaturity(e.domainMaturity)),xr(1),ra("ngForOf",e.graphdata)}}function rvn(n,t){if(1&n&&(aa(0,"div"),aa(1,"p",35),aa(2,"b"),Qa(3),ca(),Qa(4),ca(),ca()),2&n){var e=t.$implicit,o=t.index;xr(3),Xa("Domain ",o+1,":"),xr(1),Xa(" ",e.domainName,"")}}function ivn(n,t){if(1&n&&(aa(0,"div"),aa(1,"p",36),aa(2,"b"),Qa(3),ca(),ca(),ca()),2&n){var e=t.$implicit;xr(3),$a(e.domainMaturity)}}va