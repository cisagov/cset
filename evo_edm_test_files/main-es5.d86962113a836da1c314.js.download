the type and sensitivity of information to be protected and the associated range of threats. The model consists of maturity processes and cybersecurity best practices from multiple cybersecurity standards, frameworks and other references, as well as inputs from the broader community. "),ca(),aa(23,"p"),Qa(24,"CMMC is broken into five different levels of Processes and Capabilities (which are further broken down into Practices)."),ca(),aa(25,"a",11),Qa(26,"For more information see the CMMC document"),ca(),Qa(27,". "),ca(),aa(28,"div",12),la(29,"img",13),ca(),ca(),ca(),aa(30,"div",2),aa(31,"h4"),aa(32,"input",14),Ca("change",function(n){return t.changeSelection(n,"EDM")}),ca(),aa(33,"label",15),Qa(34,"EDM"),ca(),ca(),aa(35,"div",5),aa(36,"div",16),Qa(37," The External Dependency Management Assessment "),ca(),aa(38,"div",12),la(39,"img",17),ca(),ca(),ca(),ta(40,wPn,10,1,"div",18),aa(41,"div",2),aa(42,"h4"),aa(43,"input",19),Ca("change",function(n){return t.changeSelection(n,"RRA")}),ca(),aa(44,"label",20),Qa(45,"Ransomware Readiness Assessment"),ca(),ca(),aa(46,"div",5),aa(47,"div",16),aa(48,"p"),Qa(49," Ransomware poses an increasing threat and continues to rise as a top cyber threat impacting both businesses and government agencies. Ransomware is a type of malicious attack where attackers encrypt an organization's data and demand payment to restore access. In some instances, attackers may also steal an organization's information and demand an additional payment in return for not disclosing the information to authorities, competitors, or the public. Ransomware disrupts or halts an organization's operations and poses a dilemma for management: pay the ransom and hope that the attackers keep their word about restoring access and not disclosing data, or do not pay the ransom and restore operations themselves. The methods used to gain access to an organization's information and systems are common to cyberattacks more broadly, but they are aimed at forcing a ransom to be paid. Ransomware attacks target the organization's data. "),ca(),aa(50,"p"),Qa(51," To understand your cybersecurity posture and assess how well your organization is equipped to defend and recover from a ransomware incident, take the Ransomware Readiness Assessment (RRA). "),ca(),ca(),aa(52,"div",21),la(53,"img",22),ca(),ca(),ca(),la(54,"app-nav-back-next",23),ca()),2&n&&(xr(5),ra("checked",t.assessSvc.usesMaturityModel("ACET")),xr(11),ra("checked",t.assessSvc.usesMaturityModel("CMMC")),xr(9),ra("href",t.url("CMMC"),wo),xr(7),ra("checked",t.assessSvc.usesMaturityModel("EDM")),xr(8),ra("ngIf",t.configSvc.config.showCrrModelSelection),xr(3),ra("checked",t.assessSvc.usesMaturityModel("RRA")),xr(11),ra("page","model-select"))},directives:[Ps,YI],encapsulation:2}),yPn);function SPn(n,t){if(1&n){var e=ma();aa(0,"label",7),aa(1,"input",8),Ca("click",function(){ot(e);var n=t.$implicit;return Pa().saveLevel(n.Level)})("keyup.enter",function(){ot(e);var n=t.$implicit;return Pa().saveLevel(n.Level)}),ca(),Qa(2),ca()}if(2&n){var o=t.$implicit,r=Pa();Ra("activeLevel",o.Level<=(null==r.assessSvc.assessment?null:r.assessSvc.assessment.MaturityModel.MaturityTargetLevel)),xr(1),ra("checked",o.Level===(null==r.assessSvc.assessment?null:r.assessSvc.assessment.MaturityModel.MaturityTargetLevel)),xr(1),Xa(" ",o.Label," ")}}function LPn(n,t){1&n&&(aa(0,"p",9),Qa(1," Click a level to see its description. "),ca())}function zPn(n,t){1&n&&(aa(0,"div"),aa(1,"h4"),Qa(2,"CMMC Level 1"),ca(),aa(3,"ul"),aa(4,"li"),aa(5,"h5"),Qa(6,"Processes: Performed"),ca(),aa(7,"div",9),Qa(8," Level 1 requires that an organization performs the specified practices. Because the organization may be able to perform these practices only in an ad-hoc manner and may or may not rely on documentation, process maturity is not assessed for Level 1. "),ca(),ca(),aa(9,"li"),aa(10,"h5"),Qa(11,"Practices: Basic Cyber Hygiene"),ca(),aa(12,"div",9),Qa(13," Level 1 focuses on the protection of FCI and consists only of practices tha