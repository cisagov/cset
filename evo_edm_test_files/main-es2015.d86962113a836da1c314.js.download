y the ransom and hope that the attackers keep their word about restoring access and not disclosing data, or do not pay the ransom and restore operations themselves. The methods used to gain access to an organization's information and systems are common to cyberattacks more broadly, but they are aimed at forcing a ransom to be paid. Ransomware attacks target the organization's data. "),$i(),Gi(50,"p"),ja(51," To understand your cybersecurity posture and assess how well your organization is equipped to defend and recover from a ransomware incident, take the Ransomware Readiness Assessment (RRA). "),$i(),$i(),Gi(52,"div",21),Ki(53,"img",22),$i(),$i(),$i(),Ki(54,"app-nav-back-next",23),$i()),2&t&&(sr(5),Ui("checked",n.assessSvc.usesMaturityModel("ACET")),sr(11),Ui("checked",n.assessSvc.usesMaturityModel("CMMC")),sr(9),Ui("href",n.url("CMMC"),mo),sr(7),Ui("checked",n.assessSvc.usesMaturityModel("EDM")),sr(8),Ui("ngIf",n.configSvc.config.showCrrModelSelection),sr(3),Ui("checked",n.assessSvc.usesMaturityModel("RRA")),sr(11),Ui("page","model-select"))},directives:[nd,iD],encapsulation:2}),t})();function ust(t,n){if(1&t){const t=Ji();Gi(0,"label",7),Gi(1,"input",8),oa("click",function(){qt(t);const e=n.$implicit;return la().saveLevel(e.Level)})("keyup.enter",function(){qt(t);const e=n.$implicit;return la().saveLevel(e.Level)}),$i(),ja(2),$i()}if(2&t){const t=n.$implicit,e=la();xa("activeLevel",t.Level<=(null==e.assessSvc.assessment?null:e.assessSvc.assessment.MaturityModel.MaturityTargetLevel)),sr(1),Ui("checked",t.Level===(null==e.assessSvc.assessment?null:e.assessSvc.assessment.MaturityModel.MaturityTargetLevel)),sr(1),Ra(" ",t.Label," ")}}function fst(t,n){1&t&&(Gi(0,"p",9),ja(1," Click a level to see its description. "),$i())}function hst(t,n){1&t&&(Gi(0,"div"),Gi(1,"h4"),ja(2,"CMMC Level 1"),$i(),Gi(3,"ul"),Gi(4,"li"),Gi(5,"h5"),ja(6,"Processes: Performed"),$i(),Gi(7,"div",9),ja(8," Level 1 requires that an organization performs the specified practices. Because the orga