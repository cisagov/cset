mages/CMMC/tutorial/drex_cmmc_tutorial_custom_28.png",1,"my-3",2,"border","solid 0px"],["alt","Image showing the References Icon highlighted expanding the CMMC Source Documents and Help Documents available.","width","600","height","142","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_29.png",1,"my-3",2,"border","solid 2px"],["alt","Image shows Observations Icon highlighted.","width","600","height","151","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_30.png",1,"my-3",2,"border","solid 1px"],["alt","","width","600","height","323","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_31.png",1,"my-3",2,"border","solid 0px"],["alt","","width","600","height","557","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_32.png",1,"de_780D01ADE8",2,"border","solid 0px"],["alt","Image shows Feedback Icon highlighted with comments in text box.","width","600","height","179","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_33.png",1,"my-3",2,"border","solid 1px"],["alt","Image shows the Results tab selected.","width","350","height","44","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_34.png",1,"my-3"],["href","/Documents/htmlhelp_cmmc/3_2__results.htm","target","_blank"],["href","/Documents/htmlhelp_cmmc/reports.htm","target","_blank"],["alt","Image shows the Feedback screen with an option to email.","width","650","height","425","src","assets/images/CMMC/tutorial/drex_cmmc_tutorial_custom_35.png",1,"my-3"],[3,"page"]],template:function(t,n){if(1&t){Gi(0,"div",0),Gi(1,"h3",1),ja(2,"CMMC Tutorial"),$i(),Gi(3,"div",2),Gi(4,"h4"),ja(5,"Overview"),$i(),Gi(6,"p"),ja(7,"In general, a maturity model is a set of characteristics, attributes, indicators, or patterns that represent capability and progression in a particular discipline. The content of such a model typically exemplifies best practices and may incorporate standards or other codes of practice of that discipline. A maturity model thus provides a benchmark against which an organization can evaluate the current level of capability of its processes, practices, and methods and set goals and priorities for improvement."),$i(),Gi(8,"p"),ja(9,"The CMMC assessment process provides consistent guidance for assessing a contractor against a specific CMMC level."),$i(),$i(),Gi(10,"div",2),Gi(11,"h5"),ja(12,"Cybersecurity Maturity Model Certification (CMMC)"),$i(),Gi(13,"p"),ja(14," CMMC stands for \u201cCybersecurity Maturity Model Certification\u201d and is a unifying standard for the implementation of cybersecurity across the Defense Industrial Base (DIB). The CMMC framework includes a comprehensive and scalable certification element to verify the implementation of processes and practices associated with the achievement of a cybersecurity maturity level. CMMC is designed to provide increased assurance to the Department that a DIB company can adequately protect sensitive unclassified information, accounting for information flow down to subcontractors in a multi-tier supply chain. "),$i(),$i(),Gi(15,"div",2),Gi(16,"h5"),ja(17,"CMMC Levels and Focus Areas"),$i(),Gi(18,"p"),ja(19," CMMC Levels 1 through 3 consist of the security requirements specified in National Institute of Standards and Technology (NIST) Special Publication (SP) 800-171, Protecting Controlled Unclassified Information in Nonfederal Systems and Organizations. Levels 1 through 3 also include an additional 20 CMMC specific- practices along with 3 CMMC maturity processes for each of the 17 CMMC domains. "),$i(),Gi(20,"p"),ja(21," CMMC Levels 4 and 5 include a subset of the enhanced security requirements from NIST SP 800-171B as well as other cybersecurity best practices and show that the contractor is capable of reducing the risk of Advanced Persistent Threats. "),$i(),Gi(22,"p"),ja(23," As a contractor moves toward Level 5, they are required to standardize and optimize process implementation across the organization. "),$i(),$i(),Gi(24,"div",2),Gi(25,"h5"),ja(26,"Setting the Target Level"),$i(),Gi(27,"p"),ja(28," The first step to completing the CMMC practice questions is to set your desired target level. If you are unsure of your target level, check your RFI or RFP documents for the required CMMC compliance level for your contract or choose your level based on the following guidance. Additional guidance on CMMC Levels can be found in the CSET Resource Library's collection of CMMC materials. Recommended reading includes the "),Gi(29,"a",3),ja(30,"CMMC Model Certification 1.02 (March 2020)"),$i(),ja(31,", "),Gi(32,"a",4),ja(33,"CMMC Assessment Guide: Level 1 v.1.10 (November 2020)"),$i(),ja(34,", and "),Gi(35,"a",5),ja(36,"CMMC Assessment Guide: Level 3, v.1.10 (November 2020)"),$i(),ja(37,". "),$i(),Gi(38,"ul"),Gi(39,"li"),ja(40,"Level 1: Safeguard Federal Contract Information (FCI)"),$i(),Gi(41,"li"),ja(42,"Level 2: Serve as transition step in cybersecurity maturity progression to protect CUI"),$i(),Gi(43,"li"),ja(44,"Level 3: Protect Controlled Unclassified Information (CUI)"),$i(),Gi(45,"li"),ja(46,"Levels 4-5: Protect CUI and reduce risk of Advanced Persistent Threats (APTs)"),$i(),$i(),$i(),Ki(47,"img",6),Gi(48,"div",7),ja(49,"Figure 1: CMMC Levels and Associated Focus Areas"),$i(),Gi(50,"div",2),Gi(51,"h5"),ja(52,"Level 1"),$i(),Gi(53,"p"),ja(54," Level 1 safeguards Federal Contract Information (FCI). Level 1 encompasses the basic safeguarding requirements for FCI specified in Federal Acquisition Regulation (FAR) Clause 52.204-21, which defines FCI as: "),$i(),Gi(55,"p"),Gi(56,"em"),ja(57,"Information, not intended for public release, that is provided by or generated for the Government under a contract to develop or deliver a product or service to the Government, but not including information provided by the Government to the public (such as on public websites) or simple transactional information, such as necessary to process payments."),$i(),$i(),Gi(58,"p"),ja(59," Department of Defense (DoD) contracts that specify the need for a contractor to process, store, or transmit FCI only require the contractor to comply with CMMC Level 1 practices. There is no CMMC process maturity assessed at Level 1. "),$i(),$i(),Gi(60,"div",2),Gi(61,"h5"),ja(62,"Level 2"),$i(),Gi(63,"p"),ja(64," Level 2 is a transitional level. At Level 2, a contractor is not yet approved for CUI. CMMC Level 2 practices and processes provide additional safeguarding above CMMC Level 1 and help to prepare a contractor to handle CUI at CMMC Level 3. "),$i(),$i(),Gi(65,"div",2),Gi(66,"h5"),ja(67,"Level 3"),$i(),Gi(68,"p"),ja(69," CMMC Level 3 addresses the protection of Controlled Unclassified Information (CUI). The National Archives and Record Administration (NARA) defines CUI as: "),$i(),Gi(70,"p"),Gi(71,"em"),ja(72," Information that requires safeguarding or dissemination controls pursuant to and consistent with laws, regulations, and government-wide policies, excluding information that is classified under Executive Order 13526, Classified National Security Information, December 29, 2009, or any predecessor or successor order, or Atomic Energy Act of 1954, as amended."),$i(),$i(),Gi(73,"p"),ja(74," A CMMC Level 3 assessment encompasses the practices and processes of CMMC Levels 1, 2, and 3. CMMC Level 3 shows that a contractor can adequately protect CUI at the appropriate risk level while accounting for subcontractor information flow in a multi-tier supply chain. "),$i(),$i(),Gi(75,"div",2),Gi(76,"h5"),ja(77,"Level 4"),$i(),Gi(78,"p"),ja(79," Level 4 provides increased assurance to the DoD that a contractor is capable of protecting CUI while working to reduce the risk of Advanced Persistent Threats and focuses on the protection of CUI from APTs. It encompasses cybersecurity best practices along with enhanced security requirements from NIST SP 800-171B . These practices enhance the detection and response capabilities of an organization to address and adapt to the changing tactics, techniques and procedures (TTPs) used by APTs. "),$i(),$i(),Gi(80,"div",2),Gi(81,"h5"),ja(82,"Level 5"),$i(),Gi(83,"p"),ja(84," Level 5 continues the focus on the protection of CUI from APTs and requires a contractor to standardize and optimize process implementation across the organization. "),$i(),$i(),Gi(85,"div",2),Gi(86,"h4"),ja(87,"CMMC Practice Questions"),$i(),Gi(88,"p"),ja(89," The CMMC model measures not only process maturity or institutionalization, but also the implementation of practices. The model consists of 171 practices that are mapped across the five levels for all capabilities and domains. This mapping and the cumulative nature of the model is shown in Figure 2 below. "),$i(),$i(),Gi(90,"div",2),Ki(91,"img",8),Gi(92,"div",7),ja(93,"Figure 2: CMMC Levels and Associated Practices"),$i(),$i(),Gi(94,"div",2),Gi(95,"h4"),ja(96,"CSET's CMMC Assessment Features"),$i(),Gi(97,"h5"),ja(98,"Note: The guidance below shows screen captures based on the Assessment tab in the Menu Bar selected."),$i(),Ki(99,"img",9),Gi(100,"table",10),Gi(101,"tr"),Gi(102,"td",11),Ki(103,"img",12),$i(),Gi(104,"td",13),Gi(105,"h5"),ja(106," Tools "),$i(),Ki(107,"img",14),Gi(108,"p"),ja(109," Selecting the drop-down Tools option expands the menu to show the following options. (For more detail on the Tools Menu options, visit the "),Gi(110,"a",15),ja(111,"CSET User's Guide"),$i(),ja(112,".)"),$i(),Ki(113,"img",16),$i(),$i(),Gi(114,"tr"),Gi(115,"td",11),Ki(116,"img",17),$i(),Gi(117,"td",13),Gi(118,"h5"),ja(119,"Expand / Collapse Sidebar Menu"),$i(),Ki(120,"img",18),Gi(121,"p"),ja(122," This function expands the Sidebar Menu which includes links to the following assesment features: "),$i(),Ki(123,"img",19),$i(),$i(),Gi(124,"tr"),Gi(125,"td",11),Ki(126,"img",20),$i(),Gi(127,"td",13),Gi(128,"h5"),ja(129,"Resource Library"),$i(),Ki(130,"img",21),Gi(131,"p"),ja(132," The Resource Library offers a collection of CSET's cybersecurity guidance documents and reference materials. "),$i(),$i(),$i(),Gi(133,"tr"),Gi(134,"td",11),Ki(135,"img",22),$i(),Gi(136,"td",13),Gi(137,"h5"),ja(138,"Prepare Section"),$i(),Ki(139,"img",23),Gi(140,"div"),ja(141," The Prepare step is the first part of the assessment process and includes the following preparatory pages: "),Gi(142,"ul"),Gi(143,"li"),ja(144,"The Assessment Configuration and Assessment Options fields to collect the user's information and assessment selections"),$i(),Gi(145,"li"),ja(146,"The Assessment Information screen where the user's basic demographic information is collected"),$i(),Gi(147,"li"),ja(148,"The remaining screens in the Prepare Step are tailored to the specifics of the user's Assessment Option choice"),$i(),$i(),$i(),$i(),$i(),Gi(149,"tr"),Gi(150,"td",11),Ki(151,"img",24),$i(),Gi(152,"td",13),Gi(153,"h5"),ja(154,"Assessment Section"),$i(),Ki(155,"img",25),Gi(156,"p"),ja(157," Depending on whether the user has selected the Maturity Model, Standard, or Network Diagram, this section will display the "),Gi(158,"strong"),ja(159,"Maturity Model"),$i(),ja(160," selection page or the "),Gi(161,"strong"),ja(162,"Security Assurance Level (SAL)"),$i(),ja(163," selection page. "),$i(),$i(),$i(),Gi(164,"tr"),Gi(165,"td",11),Ki(166,"img",26),$i(),Gi(167,"td",13),Gi(168,"h5"),ja(169,"Results"),$i(),Ki(170,"img",27),Gi(171,"p"),ja(172," The Results section details the various compliance metrics and measurements resulting from a completed assessment."),$i(),Gi(173,"p"),ja(174," The "),Gi(175,"strong"),ja(176,"Reports"),$i(),ja(177," section is located after the "),Gi(178,"strong"),ja(179,"Results"),$i(),ja(180," section in the "),Gi(181,"strong"),ja(182,"Sidebar Menu"),$i(),ja(183,". "),$i(),$i(),$i(),$i(),$i(),Gi(184,"div",2),Gi(185,"h4"),ja(186,"CMMC Assessment Steps"),$i(),Gi(187,"div"),Gi(188,"h5"),ja(189,"1. Prepare"),$i(),Ki(190,"img",28),$i(),Gi(191,"div",2),ja(192,"The first step to completing the CMMC practice questions is to set your desired target level. If you are unsure of your target level, see the "),Gi(193,"strong"),ja(194,"CMMC Levels and Focus Areas"),$i(),ja(195," section above, or check your RFI or RFP documents for the required CMMC compliance level for your contract. "),$i(),Gi(196,"div"),Ki(197,"img",29),$i(),$i(),Gi(198,"div",2),Gi(199,"h5"),ja(200,"2. Beginning the assessment "),$i(),Gi(201,"div"),Ki(202,"img",30),$i(),Gi(203,"div"),Gi(204,"h6"),ja(205,"Tailoring the Assessment: Filtering Practice Questions and Content on the Screen "),$i(),$i(),Gi(206,"div"),ja(207,"Before starting the assessment, you may wish to tailor the content and questions you interact with."),$i(),Gi(208,"div"),ja(209,"To tailor your assessment, at the top right corner of the Assessment screen, note the "),Ki(210,"img",31),ja(211," buttons. "),$i(),Gi(212,"div"),Ki(213,"img",32),$i(),Gi(214,"div"),Gi(215,"div",33),Gi(216,"table"),Gi(217,"tr"),Gi(218,"td"),Gi(219,"div"),Ki(220,"img",34),Gi(221,"div",35),Gi(222,"h6"),ja(223,"Collapse All | Expand All Button"),$i(),$i(),$i(),Gi(224,"div",36),Ki(225,"img",37),$i(),Gi(226,"div"),ja(227,"While in the "),Gi(228,"strong"),ja(229,"Assessment Section"),$i(),ja(230," of CMMC, users can click the the "),Gi(231,"strong"),ja(232,"Collapse/Expand All "),Ki(233,"img",38),$i(),ja(234," buttons at the top right of the screen to adjust the amount of practice questions content on the page. "),$i(),$i(),$i(),$i(),$i(),$i(),Gi(235,"div"),Gi(236,"div",33),Gi(237,"table"),Gi(238,"tr"),Gi(239,"td"),Gi(240,"div"),Ki(241,"img",39),Gi(242,"div",35),Gi(243,"h6"),ja(244,"Questions Filter"),$i(),$i(),$i(),Gi(245,"div",36),Ki(246,"img",40),$i(),Gi(247,"div"),ja(248,"The "),Gi(249,"strong"),ja(250,"Questions Filter"),$i(),ja(251," helps further tailor the types of content users interact with during the assessment. "),$i(),$i(),$i(),$i(),$i(),$i(),Gi(252,"div"),Gi(253,"h6"),ja(254,"To View all CMMC Level Practice Questions Regardless of Target Level"),$i(),$i(),Gi(255,"div"),ja(256,"In the Questions Filter pop-up screen (below) users can select the option to view questions above their set target level during the assessment. This will not affect the assessment target level scoring. Any additional questions answered beyond the user's selected target level will be shaded gray on the reports and not calculated in the final maturity score."),$i(),Gi(257,"div"),Gi(258,"h6"),ja(259,"Questions Filter Pop-Up "),$i(),$i(),Gi(260,"div"),ja(261,"Select and de-select the checkboxes to tailor your practice questions throughout the assessment process. When you have finished the assessment, this feature is also useful during review."),$i(),Gi(262,"div"),Ki(263,"img",41),$i(),$i(),Gi(264,"div",2),Gi(265,"h5"),ja(266,"3. Navigating the Assessment"),$i(),Gi(267,"h6"),ja(268,"CMMC Practice Question Layout"),$i(),Gi(269,"div"),Ki(270,"img",42),$i(),Gi(271,"div"),Gi(272,"div",33),Gi(273,"table"),Gi(274,"tr"),Gi(275,"td"),Gi(276,"div"),Ki(277,"img",43),Gi(278,"div",35),Gi(279,"h6"),ja(280,"Domain and Domain Acronym"),$i(),$i(),$i(),Gi(281,"div",36),Ki(282,"img",44),$i(),Gi(283,"div"),ja(284,"The CMMC model consists of 17 domains. The majority of these domains originate from the security-related areas in Federal Information Processing Standards (FIPS) Publication 200 and the related security requirement families from NIST SP 800-171. The CMMC model also includes the three domains of Asset Management (AM), Recovery (RE), and Situational Awareness (SA)."),$i(),$i(),$i(),$i(),$i(),$i(),Gi(285,"div"),Gi(286,"div",33),Gi(287,"table"),Gi(288,"tr"),Gi(289,"td"),Gi(290,"div"),Ki(291,"img",45),Gi(292,"div",35),Gi(293,"h6"),ja(294,"Practice Identifier"),$i(),$i(),$i(),Gi(295,"div",36),Gi(296,"strong"),ja(297,"AC.1.0001"),$i(),$i(),Gi(298,"div"),ja(299,"Each CMMC practice is specified using the convention of "),Gi(300,"strong"),ja(301,"[DOMAIN].[LEVEL].[PRACTICE NUMBER]"),$i(),$i(),$i(),$i(),$i(),$i(),$i(),Gi(302,"div"),Gi(303,"div",33),Gi(304,"table"),Gi(305,"tr"),Gi(306,"td"),Gi(307,"div"),Ki(308,"img",46),Gi(309,"div",35),Gi(310,"h6"),ja(311,"Capability"),$i(),$i(),$i(),Gi(312,"div",36),Ki(313,"img",47),$i(),Gi(314,"div"),ja(315,"There are 43 capabilities associated with the 17 domains in the CMMC model."),$i(),$i(),$i(),$i(),$i(),$i(),Gi(316,"div"),Gi(317,"div",33),Gi(318,"table"),Gi(319,"tr"),Gi(320,"td"),Gi(321,"div"),Ki(322,"img",48),Gi(323,"div",35),Gi(324,"h6"),ja(325,"Level Indicator"),$i(),$i(),$i(),Gi(326,"div",36),Ki(327,"img",49),$i(),Gi(328,"div"),ja(329,"Indicates the corresponding level associated with the practice statement. CMMC provides a benchmark against which an organization can evaluate the current "),Gi(330,"strong"),ja(331,"level"),$i(),ja(332," of capability of its processes, practices, and methods and set goals and priorities for improvement. "),$i(),Gi(333,"div"),Gi(334,"span",50),ja(335,"The CMMC assessment process provides consistent guidance for assessing a contractor against specific CMMC "),Gi(336,"strong"),ja(337,"Levels 1-5."),$i(),$i(),$i(),$i(),$i(),$i(),$i(),$i(),Gi(338,"div"),Gi(339,"div",33),Gi(340,"table"),Gi(341,"tr"),Gi(342,"td"),Gi(343,"div"),Ki(344,"img",51),Gi(345,"div",35),Gi(346,"h6"),ja(347,"CSET Icons"),$i(),$i(),$i(),Gi(348,"div",36),Ki(349,"img",52),$i(),Gi(350,"div",36),ja(351,"In the "),Gi(352,"strong"),ja(353,"CSET Icons"),$i(),ja(354," section below, you will find a breakdown of each of the CSET-specific icons and how they help facilitate a CMMC assessment. "),$i(),$i(),$i(),$i(),$i(),$i(),Gi(355,"div"),Gi(356,"div",33),Gi(357,"table"),Gi(358,"tr"),Gi(359,"td"),Gi(360,"div"),Ki(361,"img",53),Gi(362,"div",35),Gi(363,"h6"),ja(364,"Practice Statement"),$i(),$i(),$i(),Gi(365,"div",36),Ki(366,"img",54),$i(),Gi(367,"div"),ja(368,"The CMMC model consists of 171 practices that are mapped across the five levels for all capabilities and domains. This mapping and the cumulative nature of the model is shown in Figure."),$i(),$i(),$i(),$i(),$i(),$i(),Gi(369,"div"),Gi(370,"div",33),Gi(371,"table"),Gi(372,"tr"),Gi(373,"td"),Gi(374,"div"),Ki(375,"img",55),Gi(376,"div",35),Gi(377,"h6"),ja(378,"Assessment Findings (CSET Answer Key)"),$i(),$i(),$i(),Gi(379,"div",36),Ki(380,"img",56),$i(),Gi(381,"div",36),ja(382,"A full breakdown of the CMMC Assessment Findings (CSET Answer Key) is below."),$i(),$i(),$i(),$i(),$i(),$i(),Gi(383,"div"),Gi(384,"div",33),Gi(385,"table"),Gi(386,"tr"),Gi(387,"td"),Gi(388,"div"),Ki(389,"img",57),Gi(390,"div",35),Gi(391,"h6"),ja(392,"Progress Indicator"),$i(),$i(),$i(),Gi(393,"div",36),Ki(394,"img",58),$i(),Gi(395,"div",36),ja(396,"The Progress Indicator will turn blue and complete the circle as the questions in each Capability area are completed. When all the questions are complete, the Progress Indicator will show a check mark. "),$i(),$i(),$i(),$i(),$i(),$i(),Gi(397,"div"),Gi(398,"h6"),ja(399,"CMMC Practice Identifiers "),$i(),$i(),Gi(400,"div"),Ki(401,"img",59),ja(402,"\xa0 Each practice is specified using the convention of "),Gi(403,"strong"),ja(404,"[DOMAIN].[LEVEL].[PRACTICE NUMBER]"),$i(),ja(405," above the applicable "),Gi(406,"strong"),ja(407,"level number"),$i(),ja(408," for the practice."),$i(),Gi(409,"ul"),Gi(410,"li"),Gi(411,"strong"),ja(412,"DOMAIN"),$i(),ja(413," is the two letter domain abbreviation;"),$i(),Gi(414,"li"),Gi(415,"strong"),ja(416,"LEVEL"),$i(),ja(417," is the level number; and"),$i(),Gi(418,"li"),Gi(419,"strong"),ja(420,"PRACTICE NUMBER"),$i(),ja(421," is the identifier assigned to that practice."),$i(),Gi(422,"li"),Gi(423,"strong"),ja(424,"Level 1, 2, 3, 4, or 5."),$i(),$i(),$i(),Gi(425,"div"),Gi(426,"h6"),ja(427,"CSET Answer Key for CMMC"),$i(),$i(),Gi(428,"div"),Ki(429,"img",60),$i(),$i(),Gi(430,"div",2),Gi(431,"h5"),ja(432,"4. Answering the Practice Questions"),$i(),Gi(433,"div"),Ki(434,"img",61),Gi(435,"span",62),Gi(436,"strong"),ja(437," MET"),$i(),$i(),ja(438," is presented as "),Gi(439,"strong"),ja(440,"Yes"),$i(),ja(441," in the CSET "),Gi(442,"span",62),ja(443,"Assessment "),$i(),ja(444,"Tool"),Gi(445,"span",62),ja(446,". The contractor successfully meets the practice. For "),$i(),$i(),Gi(447,"div"),Gi(448,"span",62),ja(449,"each practice marked MET, the assessor includes statements that indicate the response conforms to the objectives and documents the appropriate evidence to support the response. "),$i(),$i(),Gi(450,"div"),Gi(451,"span",62),ja(452,"For "),Gi(453,"strong"),ja(454,"MET (Yes)"),$i(),ja(455,", the assessor can use the "),Gi(456,"strong"),ja(457,"Observations"),$i(),ja(458," field to record applicable observations."),$i(),$i(),Gi(459,"div"),Ki(460,"img",63),$i(),Gi(461,"div"),Ki(462,"img",64),Gi(463,"span",62),Gi(464,"strong"),ja(465," NOT MET"),$i(),ja(466," is presented as "),Gi(467,"strong"),ja(468,"NO"),$i(),ja(469," in the CSET Assessment tool. The contractor has not met the practice. For each practice marked NOT MET, the assessor includes statements that explain why and documents the appropriate evidence that the contractor does not conform to the objectives."),$i(),$i(),Gi(470,"div"),Gi(471,"span",62),ja(472,"For "),Gi(473,"strong"),ja(474,"NOT MET"),$i(),Gi(475,"strong"),ja(476,"(No)"),$i(),ja(477,", the assessor can use the "),Gi(478,"strong"),ja(479,"Observations"),$i(),ja(480," field to record applicable observations."),$i(),$i(),Gi(481,"div"),Ki(482,"img",65),$i(),Gi(483,"div"),Gi(484,"span",62),ja(485,"\xa0"),$i(),$i(),Gi(486,"div"),Gi(487,"h6"),ja(488,"Inherited Practice Objectives - MET"),$i(),$i(),Gi(489,"div"),Gi(490,"span",62),ja(491,"Note: A contractor can inherit practice objectives. A practice objective that is inherited is met because adequate evidence is provided that the enterprise or another entity, such as an External Service Provider (ESP), performs the practice objective. Evidence from the enterprise or the entity from which the objectives are inherited should show they are applicable to in-scope assets and that the assessment objectives are met. For each practice objective that is inherited, the assessor includes statements that indicate how they were evaluated and from whom they are inherited. If the contractor cannot demonstrate adequate evidence for all assessment objectives, through either contractor evidence or evidence of inheritance, the contractor will receive a NOT MET for the practice."),$i(),$i(),Gi(492,"div"),Ki(493,"img",66),Gi(494,"span",62),Gi(495,"strong"),ja(496,"\xa0 NOT APPLICABLE"),$i(),$i(),ja(497,"is presented as "),Gi(498,"strong"),ja(499,"ALT"),$i(),ja(500," n the CSET "),Gi(501,"span",62),ja(502,"Assessment "),$i(),ja(503,"Tool"),Gi(504,"span",62),ja(505,". ALT indicates the practice does not apply for the assessment. For each practice marked ALT, the assessor is required to include a statement that explains why the practicedoes not apply to the contractor.\xa0 "),$i(),$i(),Gi(506,"div"),Gi(507,"span",62),ja(508,"Assessor comments can be recorded in the pop-up alternate justification text box beneath the question."),$i(),$i(),Gi(509,"div"),Ki(510,"img",67),$i(),Gi(511,"div");Gi(512,"h6"),ja(513,"Mark for Review"),$i(),$i(),Gi(514,"div"),Gi(515,"span",62),ja(516,'The mark for review function allows a user to indicate that a practice question requires further review. Marked practices are listed in the "Comments and Marked for Review CMMC" report. In this section of the CSET Report Page (left side navigation "Reports"), the user can locate comments specific to each practice question and recall any practices that were marked for review. '),$i(),$i(),Gi(517,"div"),Ki(518,"img",68),$i(),Gi(519,"div"),Gi(520,"h6"),ja(521,"Supplemental Guidance"),$i(),$i(),Gi(522,"div"),Gi(523,"span",62),ja(524,"Users can refer to the supporting authorities and additional guidance provided under "),Gi(525,"strong"),ja(526,"Supplemental Guidance"),$i(),ja(527,". "),$i(),$i(),Gi(528,"div"),Gi(529,"span",62),ja(530,"Many of these documents can be found in the "),$i(),Gi(531,"a",69),ja(532,"CSET Resource Library."),$i(),$i(),Gi(533,"div"),Ki(534,"img",70),$i(),Gi(535,"div"),Gi(536,"h6"),ja(537,"Comments "),$i(),$i(),Gi(538,"div",71),ja(539,'The comments function allows the assessor to record non-structured comments for each question during the assessment. Practices with comments are listed in the "Comments and Marked for Review CMMC" report. In this section of the CSET Report Page (left side navigation "Reports"), the user can locate comments specific to each practice question and recall any practices that were marked for review. '),$i(),Gi(540,"div"),ja(541," In contrast, the Observations function (also useful for commenting) is more rigid and contains required fields. "),$i(),Gi(542,"div"),Ki(543,"img",72),$i(),Gi(544,"div",73),Gi(545,"h6"),ja(546,"Artifacts/Documents "),$i(),$i(),Gi(547,"div"),ja(548,"Assessors can use the Artifacts/Documents function to attach relevant evidence to each practice question. "),$i(),Gi(549,"div"),Ki(550,"img",74),$i(),Gi(551,"div"),ja(552,"The documents will appear listed by file name beneath the question when attached. A red indicator will appear on the icon for each question where evidence has been attached."),$i(),Gi(553,"div"),Ki(554,"img",75),$i(),Gi(555,"div"),Gi(556,"span",62),ja(557,"Access your attached documents, artifacts, and evidence under the "),Ki(558,"img",76),ja(559," Tools Menu next to the CSET Logo on the upper left side of the screen. "),$i(),$i(),Gi(560,"div"),Ki(561,"img",77),$i(),Gi(562,"div"),Gi(563,"span",62),ja(564,"The Assessment Documents tab will open up a pop-up window showing all documents that are attached to the Assessment. Documents are organized by title."),$i(),$i(),Gi(565,"div"),Ki(566,"img",78),$i(),Gi(567,"div"),Gi(568,"h6"),ja(569,"References "),$i(),$i(),Gi(570,"div"),Gi(571,"span",62),ja(572,"Users can click on the "),Gi(573,"strong"),ja(574,"References"),$i(),ja(575," icon to open links to CMMC .pdf documentation and to access CMMC assessment help documents, Errata, and the Glossary/Acronyms document. Documents will open in a separate window."),$i(),$i(),Gi(576,"div",73),Ki(577,"img",79),$i(),Gi(578,"div"),Gi(579,"h6"),ja(580,"Observations "),$i(),$i(),Gi(581,"div"),ja(582,"The Observations Icon opens a pop-up window that allows an assessor to record their observations for each practice question. "),$i(),Gi(583,"div"),Ki(584,"img",80),$i(),Gi(585,"div"),ja(586,"Once a user has entered their observations, a red indicator highlights the icon and the observations are listed beneath the practice question in order of entry. "),$i(),Gi(587,"div",73),Ki(588,"img",81),$i(),Gi(589,"div"),Gi(590,"h6"),ja(591,"Observations Details Pop-Up Screen:"),$i(),$i(),Gi(592,"div"),ja(593,"After selecting the Observations Icon, the Observations Details screen appears."),$i(),Gi(594,"div",73),Ki(595,"img",82),$i(),Gi(596,"div"),Gi(597,"h6"),ja(598,"Feedback"),$i(),$i(),Gi(599,"div"),ja(600,"Users can record Feedback during the assessment for submission to CSET/DHS. Some examples of submitted feedback include commentary on the subject matter of the question, the structure of the question, and how the question and layout can be improved. "),$i(),Gi(601,"div",73),Ki(602,"img",83),$i(),$i(),Gi(603,"div",2),Gi(604,"h5"),ja(605,"5. CMMC Results and Report"),$i(),Ki(606,"img",84),Gi(607,"p"),ja(608,"The primary deliverable of a CMMC assessment is the CMMC Site Report which contains the findings associated with the assessment. To learn more about the CMMC Results and Report functionality, visit the "),Gi(609,"a",85),ja(610,"Results"),$i(),ja(611," and "),Gi(612,"a",86),ja(613,"Reports"),$i(),ja(614," section of the CMMC User Guide. "),$i(),$i(),Gi(615,"div",2),Gi(616,"h5"),ja(617,"6. Submit Feedback"),$i(),Gi(618,"p"),ja(619," At the end of the assessment, users are prompted to submit their feedback on the CSET Assessment."),$i(),Ki(620,"img",87),$i(),Ki(621,"app-nav-back-next",88),$i()}2&t&&(sr(621),Ui("page","tutorial-cmmc"))},directives:[iD],styles:[""]}),t})(),wmt=(()=>{class t{constructor(){}ngOnInit(){}}return t.\u0275fac=function(n){return new(n||t)},t.\u0275cmp=K({type:t,selectors:[["app-tutorial-edm"]],decls:277,vars:1,consts:[[1,"white-panel","d-flex","justify-content-start","flex-column","flex-11a","tutorial"],[1,"wrap-text","mb-3"],[1,"mb-4"],[1,"mb-5"],[1,"cset-table"],[1,"text-right"],[1,"image-caption"],["src","assets/images/EDM/tutorial/image001.png","alt","Practice Questions Answer Choice Icons: Yes, No, Incomplete"],["src","assets/images/EDM/tutorial/image002.png","alt","Mark for Review Icon",1,"image-center",2,"float","left","vertical-align","top"],[1,"mt-2"],[1,"mb-3"],["src","assets/images/EDM/tutorial/image003.jpg","alt","Figure one shows the practice question layout.",1,"image-center"],["src","assets/images/EDM/tutorial/image004.jpg","alt","Guidance Icon"],["src","assets/images/EDM/tutorial/image005.jpg","alt","Comments Icon"],["src","assets/images/EDM/tutorial/image006.jpg","alt","Artifacts References Icon"],["src","assets/images/EDM/tutorial/image007.jpg","alt","References Icon"],["src","assets/images/EDM/tutorial/image008.jpg","alt","Observations Icon"],["src","assets/images/EDM/tutorial/image009.jpg","alt","Feedback Icon"],["src","assets/images/EDM/tutorial/image010.png","alt","Figure 2 shows the glossary definition pop-up embedded in the practice question text. ",1,"image-center"],["src","assets/images/EDM/tutorial/image011.png","alt","Figure 3 shows the Domain Remarks text box located at the end of each domain.",1,"image-center"],["src","assets/images/EDM/tutorial/image012.jpg","alt","Figure 4 shows an example of Asset Types.",1,"image-center"],["src","assets/images/EDM/tutorial/image013.jpg","alt","Figure 5 shows an example of the external entity types.",1,"image-center"],[1,"my-4"],[3,"page"]],template:function(t,n){1&t&&(Gi(0,"div",0),Gi(1,"h3",1),ja(2,"EDM Tutorial"),$i(),Gi(3,"div",2),Gi(4,"h5"),ja(5,"Overview"),$i(),Gi(6,"p"),ja(7,"The EDM Assessment focuses on practices to manage risks associated with external dependencies, especially risks related to information and communications technology (ICT). This type of risk\u2014also commonly called supply chain or third-party risk\u2014is of particular concern to many organizations, which increasingly have a large number of external dependencies. Organizations face inherent uncertainty in managing complex, rapidly changing, arms-length relationships involving technology. They also face a threat environment that exacerbates these concerns. The EDM Assessment helps by providing an efficient, effective way to measure and report on an organization's capability to manage this risk. The EDM Assessment also incorporates and expands on the cybersecurity concepts included in the National Institute of Standards and Technology (NIST) Cybersecurity Framework (CSF). As part of this instrument\u2019s capability, the EDM results are also depicted in terms of the NIST CSF."),$i(),Gi(8,"p"),ja(9,"External dependencies exist when external entities have defined obligations or relationships with assets or services that your organization requires to support its business objectives and mission. Examples include third parties that provide, operate, control, have access to, own, or have other responsibilities over key ICT and related assets."),$i(),$i(),Gi(10,"div",2),Gi(11,"h5"),ja(12,"The EDM Assessment"),$i(),Gi(13,"p"),ja(14,"The EDM Assessment consists of a structured interview of key personnel which takes about a half-day to complete. Its goal is to measure and report on an organization's cybersecurity practices as they relate to managing external dependencies and their associated risks."),$i(),Gi(15,"p"),ja(16,"The EDM Assessment reflects an organization\u2019s capabilities at a single point in time\u2014at the time of the assessment."),$i(),Gi(17,"p"),ja(18,"The assessment does not consider:"),$i(),Gi(19,"ul"),Gi(20,"li"),ja(21,"activities that are planned or are in the process of implementation "),$i(),Gi(22,"li"),ja(23,"practices that have not been performed for extended periods. For example, if the organization has a disaster recovery plan that, in the opinion of the participants, is out of date to the point of being unusable, the plan should not be considered. "),$i(),$i(),$i(),Gi(24,"div",2),Gi(25,"h5"),ja(26,"External Entity Services "),$i(),Gi(27,"p"),ja(28,"Examples of dependencies include external entities that provide:"),$i(),Gi(29,"ul"),Gi(30,"li"),ja(31," services that explicitly involve the operation, maintenance, or provisioning of ICT for the organization. Examples of these services include cloud services, data hosting, on-site maintenance services, and the operation of control systems to support the organization. "),$i(),Gi(32,"li"),ja(33," services supported by ICT, including any type of service that is appreciably supported through the use of information and communications technology. In the financial sector, examples may include the printing of account statements by the subcontractor to a banking institution. "),$i(),Gi(34,"li"),ja(35," governmental services, such as fire and police response to protect data centers. "),$i(),Gi(36,"li"),ja(37," infrastructure services such as electricity, telecommunications networks, or transportation assets. "),$i(),Gi(38,"li"),ja(39," technology products and services such as hardware and software that is utilized by the organization to provided services to its customers. "),$i(),$i(),$i(),Gi(40,"div",2),Gi(41,"h5"),ja(42,"External Entity Types"),$i(),Gi(43,"p"),ja(44,"To comprehensively measure the EDM capability of the organization and ensure completeness, several questions are asked about practices performed for different types of external entities. The external entity types used are: "),$i(),Gi(45,"ul"),Gi(46,"li"),Gi(47,"strong"),ja(48,"Supplier"),$i(),ja(49," - external entities that provide ICT-related goods and services and with which the acquirer has some ability to negotiate. These entities may also be called subcontractors or vendors. Depending on scoping and the needs of the organization, this category may also apply to supporting affiliates or separate business units of the larger enterprise. Examples of these suppliers include centrally managed IT or other business services. These relationships are sometimes governed by Operational Level Agreements. "),$i(),Gi(50,"li"),Gi(51,"strong"),ja(52,"Governmental services"),$i(),ja(53," - services provided by a governmental department or agency. These services frequently involve security; for example, fire, police, and emergency response. "),$i(),Gi(54,"li"),Gi(55,"strong"),ja(56,"Infrastructure providers"),$i(),ja(57," - supplies goods or services to a region, economy, infrastructure sector, or political subdivision; however, the acquirer normally has no commercially practical ability to negotiate with this type of supplier. Examples of infrastructure providers include water, power, or transportation. "),$i(),$i(),$i(),Gi(58,"div",2),Gi(59,"h5"),ja(60,"Critical Service Scope"),$i(),Gi(61,"p"),ja(62,"The EDM Assessment has a service orientation, meaning that it is intended to assess the organization's management of external dependencies relative to a specific critical service."),$i(),Gi(63,"p"),ja(64,"A critical service must be selected and is defined as:"),$i(),Gi(65,"p"),ja(66,"A set of activities an organization carries out in the performance of a duty or in the production of a product that is so critical to the organization's success that its disruption would severely impact continued operations or success in meeting the organization's mission."),$i(),Gi(67,"p"),ja(68,"Organizations typically have a set of critical services that define their mission. The selection of a critical service for assessment\u2014rather than assessing the organization as a whole\u2014helps to scope the assessment and tie the results to the organization's mission."),$i(),Gi(69,"p"),ja(70,"Below are some examples of organizations and their typical critical services that might be selected as part of an EDM Assessment:"),$i(),Gi(71,"ul"),Gi(72,"li"),ja(73,"banks and other financial institutions: clearing and settlement, mortgage application processing"),$i(),Gi(74,"li"),ja(75,"emergency services providers: processing 911 calls, dispatch"),$i(),Gi(76,"li"),ja(77,"electrical power plants: electricity generation, electricity distribution"),$i(),Gi(78,"li"),ja(79,"hospitals: clinical services, prescription management"),$i(),Gi(80,"li"),ja(81,"government agencies: court case management, benefit management"),$i(),Gi(82,"li"),ja(83,"manufacturing companies: machining operations, order processing"),$i(),Gi(84,"li"),ja(85,"airports: air traffic control, fuel management"),$i(),$i(),$i(),Gi(86,"div",3),Gi(87,"h5"),ja(88,"EDM Assessment Architecture and Structure"),$i(),Gi(89,"p"),ja(90,"The following table details the domains of the EDM Assessment. Each domain represents important capabilities that contribute to managing external dependencies across the lifecycle of the relationships with external organizations. "),$i(),Gi(91,"table",4),Gi(92,"tr"),Gi(93,"th"),ja(94,"EDM Assessment Domain"),$i(),Gi(95,"th",5),ja(96,"No. of Goals"),$i(),Gi(97,"th",5),ja(98,"No. of Goal Practices"),$i(),$i(),Gi(99,"tr"),Gi(100,"td"),ja(101," Relationship Formation "),$i(),Gi(102,"td",5),ja(103,"6"),$i(),Gi(104,"td",5),ja(105,"26"),$i(),$i(),Gi(106,"tr"),Gi(107,"td"),ja(108,"Relationship Management and Governance"),$i(),Gi(109,"td",5),ja(110,"7"),$i(),Gi(111,"td",5),ja(112,"30"),$i(),$i(),Gi(113,"tr"),Gi(114,"td"),ja(115,"Service Protection and Sustainment"),$i(),Gi(116,"td",5),ja(117,"3"),$i(),Gi(118,"td",5),ja(119,"15"),$i(),$i(),Gi(120,"tr"),Gi(121,"td"),ja(122," MIL Practices "),$i(),Gi(123,"td",5),ja(124,"4"),$i(),Gi(125,"td",5),ja(126,"15"),$i(),$i(),$i(),Gi(127,"div",6),ja(128,"Table 1: EDM Assessment Domain Composition: Number of Goals and Goal Practices "),$i(),$i(),Gi(129,"div",2),Gi(130,"h5"),ja(131,"Practice Questions Structure"),$i(),Gi(132,"p"),ja(133,"Each practice question contains a 3-point response scale to evaluate the degree to which the organization has implemented each practice.\xa0 Each question has three possible answers: \u201cYes\u201d, \u201cIncomplete\u201d, and \u201cNo\u201d: "),$i(),Ki(134,"img",7),Gi(135,"ul"),Gi(136,"li"),Gi(137,"strong"),ja(138,"Yes"),$i(),ja(139," \u2013 the organization fully performs the activity specified in the question."),$i(),Gi(140,"li"),Gi(141,"strong"),ja(142,"Incomplete"),$i(),ja(143," \u2013 the organization partially performs the activity"),$i(),Gi(144,"li"),Gi(145,"strong"),ja(146,"No"),$i(),ja(147," \u2013 the organization does not perform the activity at all."),$i(),$i(),Gi(148,"p"),Ki(149,"img",8),Gi(150,"span",9),Gi(151,"strong"),ja(152,"Mark for Review"),$i(),ja(153,': To the right of the three-point response scale is the flag icon which can be used to mark a practice for review. Marked questions are listed in the "EDM Comments and Marked For Review" report. In this section of the CSET Report Page (left side navigation \u201cReports\u201d), the user can locate comments specific to each practice question and recall any practices previously marked for review. '),$i(),$i(),Gi(154,"div",10),Ki(155,"img",11),Gi(156,"div",6),ja(157,"Figure 1: Practice Question Layout"),$i(),$i(),Gi(158,"p"),Ki(159,"img",12),Gi(160,"strong"),ja(161,"Supplemental Guidance"),$i(),ja(162,": To aid the facilitator, each question is supported by guidance.\xa0 The guidance should be referred to for background, possible examples and artifacts, and for criteria that defines the requirements for a \u201cYes\u201d and an \u201cIncomplete\u201d answer.\xa0 The guidance is engaged by selecting the Guidance Icon containing the letter \u201cG\u201d located below the question. "),$i(),Gi(163,"p"),Ki(164,"img",13),Gi(165,"strong"),ja(166,"Comments"),$i(),ja(167,": Selecting this icon will display a text box that may be used to make comments regarding each question. For example, the facilitator of an assessment may make a note for future reference as to the reasoning behind an \u201cincomplete\u201d response. Note: these comments are not included in the official report and are meant to be private to the facilitator. "),$i(),Gi(168,"p"),ja(169," Practices with comments are listed in the \u201cEDM Comments and Marked for Review\u201d report. In this section of the CSET Report Page (left side navigation \u201cReports\u201d), the user can locate comments specific to each practice question made during the assessment and recall any practices previously marked for review. "),$i(),Gi(170,"p"),Ki(171,"img",14),Gi(172,"strong"),ja(173,"Artifacts/Documents"),$i(),ja(174,": Easily associate, track, and store evidence, artifacts, and other supporting documents throughout the assessment."),$i(),Gi(175,"p"),Ki(176,"img",15),Gi(177,"strong"),ja(178,"References"),$i(),ja(179,": Selecting the References Icon will display the Options for Consideration associated with the particular question.\xa0 The Options for Consideration are normally found in the report but are also made available to the facilitator while performing the assessment.\xa0 These options outline general guidelines or activities and the associated sources that can be used to improve the external dependencies management and the resilience of the critical service assessed."),$i(),Gi(180,"p"),Ki(181,"img",16),Gi(182,"strong"),ja(183,"Observations"),$i(),ja(184,": Selecting this icon will pop up an observation details dialog box used to capture information about an issue associated with the particular practice along with its importance, resolution date, etc."),$i(),Gi(185,"p"),Ki(186,"img",17),Gi(187,"strong"),ja(188,"Feedback"),$i(),ja(189,": Used to provide feedback regarding the question to CISA.\xa0 For example, a user may comment that the question language is too complex and suggest alternate wording. "),$i(),$i(),Gi(190,"div",2),Gi(191,"h5"),ja(192,"Glossary Definitions"),$i(),Gi(193,"p"),ja(194,"A question may contain context-sensitive help for certain terms.\xa0 This can be accessed by hovering over the term that is underlined with a series of dots. "),$i(),Gi(195,"div",10),Ki(196,"img",18),Gi(197,"div",6),ja(198," Figure 2: Glossary Definition Pop-Up "),$i(),$i(),Gi(199,"div",2),Gi(200,"p"),ja(201,"At the end of each domain, a Domain Remarks text box is available to the user.\xa0 Any text entered in this box is copied verbatim into the report. It can be used to capture information such as reasoning or organization-specific information.\xa0 For example, if an improvement effort is already underway to address some of the practices in a particular domain, it can be detailed here to make it part of the official report.\xa0 "),Gi(202,"b"),ja(203,"Since this text is copied verbatim into the report a user should use discretion in their commentary."),$i(),ja(204,"\xa0 "),$i(),Gi(205,"div",10),Ki(206,"img",19),Gi(207,"div",6),ja(208," Figure 3: Domain Remarks Text Box "),$i(),$i(),$i(),Gi(209,"div",2),Gi(210,"h5"),ja(211,"Asset Types"),$i(),Gi(212,"p"),ja(213,"To support the accuracy and completeness of the assessment, several questions involve specific practices for each type of asset. These asset types are:"),$i(),Gi(214,"ul"),Gi(215,"li"),ja(216,"People - the staff that support data centers or otherwise use information and communications technology to deliver the service"),$i(),Gi(217,"li"),ja(218,"Information - account information, technology asset configuration files, and personal health information"),$i(),Gi(219,"li"),ja(220,"Technology - computers, software, and control systems"),$i(),Gi(221,"li"),ja(222,"Facilities - offices or data centers supporting the delivery of the service"),$i(),$i(),Gi(223,"p"),ja(224,"Some questions require a separate answer for each of the four assets while other questions refer to all assets.\xa0 See the example directly below."),$i(),Gi(225,"div",2),Ki(226,"img",20),Gi(227,"div",6),ja(228,"Figure 4: Asset Types"),$i(),$i(),$i(),Gi(229,"div",2),Gi(230,"h5"),ja(231,"External Entity Types"),$i(),Gi(232,"p"),ja(233,"As described above there are three types of external entities that the EDM assessment addresses.\xa0 To ensure completeness, several questions ask about practices performed for different types of external entities.\xa0 See the example below."),$i(),Gi(234,"div",10),Ki(235,"img",21),Gi(236,"div",6),ja(237,"Figure 5: External Entity Types"),$i(),$i(),$i(),Gi(238,"div",2),Gi(239,"h5"),ja(240,"Maturity Indicator Levels"),$i(),Gi(241,"p"),ja(242,"The EDM Assessment utilizes one standard set of Maturity Indicator Level (MIL) questions. The MIL questions examine the institutionalization of EDM practices within an organization.\xa0 Institutionalization means that cybersecurity practices become a deeper, more lasting part of the organization because they are managed and supported in meaningful ways. When cybersecurity practices become more institutionalized\u2014or \u201cembedded\u201d\u2014managers can have more confidence in the practices\u2019 predictability and reliability. Institutionalized practices are also more likely to be sustained during times of disruption or stress to the organization."),$i(),Gi(243,"p"),ja(244,"A Maturity Indicator Level (MIL) is assigned to the organization's External Dependencies Management capability. It represents a consolidated view of performance.\xa0 The EDM Assessment uses one maturity scale for all three domains because the domains represent different parts of the lifecycle.\xa0 "),$i(),Gi(245,"p"),ja(246,"The MIL scale itself uses six maturity levels, each with rigorous, defined components:"),$i(),Gi(247,"div",22),Gi(248,"h6"),ja(249,"MIL0 Incomplete -> MIL1 Performed -> MIL2 Planned -> MIL3 Managed -> MIL4 Measured -> MIL5 Defined"),$i(),$i(),Gi(250,"h6"),ja(251,"MIL0 Incomplete"),$i(),Gi(252,"p"),ja(253,"All practices in the domain are not being fully performed as measured by responses to the relevant EDM Assessment questions in the domain."),$i(),Gi(254,"h6"),ja(255,"MIL1 Performed"),$i(),Gi(256,"p"),ja(257,"All practices that support the goals in a domain are being performed as measured by responses to the relevant EDM Assessment questions."),$i(),Gi(258,"h6"),ja(259,"MIL2 Planned"),$i(),Gi(260,"p"),ja(261,"A specific practice in the EDM Assessment domain is not only performed but is also supported by planning, policy, stakeholders, and relevant standards and guidelines."),$i(),Gi(262,"h6"),ja(263,"MIL3 Managed"),$i(),Gi(264,"p"),ja(265,"All practices in a domain are performed, planned, and have the basic governance infrastructure in place, are appropriately staffed, adequately funded, and managed for risk."),$i(),Gi(266,"h6"),ja(267,"MIL4 Measured"),$i(),Gi(268,"p"),ja(269,"All practices in a domain are performed, planned, managed, monitored, and controlled. A measured process or practice is periodically evaluated for effectiveness, evaluated against its practice description and plan, and periodically reviewed with higher-level management."),$i(),Gi(270,"h6"),ja(271,"MIL5 Defined"),$i(),Gi(272,"p"),ja(273,"All practices in a domain are performed, planned, managed, measured, and consistent across all constituencies within an organization that have a vested interest in the performance of the practice. At MIL5, a process or practice is defined by the organization and tailored by individual operating units and supported by improvement information that is collected by and shared among operating units for the overall benefit of the organization."),$i(),Gi(274,"p"),ja(275,"In the above progression, an organization can only attain a given MIL if it has attained all lower MILs. In other words, an organization that fails to perform all of the cybersecurity practices at MIL1 in a domain would also fail to reach MIL2 in that domain, even if it would have satisfied all the requirements at MIL2. "),$i(),$i(),Ki(276,"app-nav-back-next",23),$i(),$i()),2&t&&(sr(276),Ui("page","tutorial-edm"))},directives:[iD],encapsulation:2}),t})();function vmt(t,n){if(1&t&&(Gi(0,"div"),Gi(1,"div",30),Gi(2,"div",24),Gi(3,"div",25),Gi(4,"h1",31),ja(5),$i(),$i(),Gi(6,"div",27),Gi(7,"div",28),ja(8),$i(),$i(),$i(),Gi(9,"div",14),Gi(10,"table",32),Gi(11,"tbody