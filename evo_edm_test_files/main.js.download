;\n}\n.question-filters > div > label {\n  font-weight: normal;\n  white-space: normal;\n}\n.question-filters > div {\n  display: flex;\n  flex-direction: row;\n  white-space: nowrap;\n  align-items: flex-start;\n}\n.filters-engaged {\n  background-color: #F9CE15;\n  margin-top: 0.2rem;\n  margin-bottom: 1rem;\n  padding: 0.6em;\n  width: 100%;\n  border-radius: 0.5em;\n  font-size: 1.4em;\n  font-weight: bold;\n  text-align: center;\n  color: #18375F;\n}\n.default-mat-filter {\n  font-weight: 700 !important;\n  font-style: italic !important;\n  font-size: 1.1rem;\n}\n.parameter-orig-value {\n  font-size: 1.1em;\n  color: #18375F;\n  margin: 10px 0;\n}\n.data-table {\n  border: 1px solid #ffffff;\n}\ntable.data-table {\n  width: 100%;\n  border: 2px solid #000000 !important;\n}\ntr.data-table:nth-child(even) {\n  background-color: #d9d9d9;\n}\ntd.data-table {\n  padding: 5px;\n  text-align: left;\n}\nth.data-table {\n  background: #18375F;\n  color: #ffffff;\n  text-align: center;\n  padding: 10px;\n}\n.chart {\n  padding-bottom: 45px;\n  text-align: center;\n}\n.report-links button {\n  display: block;\n}\n.router-flex {\n  flex: 1 1 auto;\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  overflow: hidden;\n}\n.wrap-text {\n  /* These are technically the same, but use both */\n  overflow-wrap: break-word;\n  word-wrap: break-word;\n  /* This is the dangerous one in WebKit, as it breaks things wherever */\n  /* Instead use this non-standard one: */\n  word-break: normal;\n  /* Adds a hyphen where the word breaks, if supported (No Blink) */\n  -ms-hyphens: auto;\n  -webkit-hyphens: auto;\n  hyphens: auto;\n  white-space: normal;\n}\n.ncua-header {\n  background-color: #18375F !important;\n}\n.header-help {\n  color: #F2F2F2;\n}\n.logo-fill {\n  fill: #FAFAFA;\n}\n.nav-pills > li.active > a,\n.nav-pills > li.active > a:focus {\n  background-color: #3B68AA;\n}\n.nav-pills > li.active > a:hover {\n  background-color: #6390A9;\n}\n.nav .open > a {\n  backg