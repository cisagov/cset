// import { Discovery, Individual } from '../models/discoveries.model';
class DiscoveryTearoutsComponent {
    /**
     * Constructor.
     * @param titleService
     * @param reportSvc
     */
    constructor(titleService, reportSvc) {
        this.titleService = titleService;
        this.reportSvc = reportSvc;
    }
    ngOnInit() {
        this.titleService.setTitle("Observations Tear Out Sheets - CSET");
        this.reportSvc.getReport('discoveries').subscribe((r) => {
            this.response = r;
        }, error => console.log('Discoveries Tear Out Sheets report load Error: ' + error.message));
    }
    /**
     * This generates an ID, but Angular doesn't support this kind of href link
     * so it won't work for production.
     * @param individual
     */
    buildTocEntry(individual) {
        return "#indiv_" + individual.INDIVIDUALFULLNAME.replace(' ', '_');
    }
}
