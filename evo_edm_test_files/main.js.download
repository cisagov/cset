class ExecutiveCMMCComponent {
    constructor(reportSvc, analysisSvc, titleService, cmmcStyleSvc) {
        this.reportSvc = reportSvc;
        this.analysisSvc = analysisSvc;
        this.titleService = titleService;
        this.cmmcStyleSvc = cmmcStyleSvc;
        // Charts for Components
        this.componentCount = 0;
        this.warningCount = 0;
        this.numberOfStandards = -1;
        this.pageInitialized = false;
        this.gridColumnCount = 10;
        this.gridColumns = new Array(this.gridColumnCount);
        this.columnWidthEmitter = new rxjs__WEBPACK_IMPORTED_MODULE_5__["BehaviorSubject"](25);
    }
    ngOnInit() {
        this.cmmcStyleSvc.getData();
        this.titleService.setTitle("Executive Summary - CSET");
        this.reportSvc.getReport('executivecmmc').subscribe((r) => {
            this.response = r;
        }, error => console.log('Executive report load Error: ' + error.message));
        this.columnWidthEmitter.subscribe(item => {
            $(".gridCell").css("width", `${item}px`);
        });
    }
    ngAfterViewInit() {
        this.getcolumnWidth();
    }
    ngAfterViewChecked() {
        this.getcolumnWidth();
    }
    //horizontalDomainBarChat
    getcolumnWidth() {
        this.columnWidthPx = this.gridChartData.nativeElement.clientWidth / this.gridColumns.length;
        this.columnWidthEmitter.next(this.columnWidthPx);
    }
    getBarWidth(data) {
        return {
            'flex-grow': data.questionAnswered / data.questionCount,
            'background': this.cmmcStyleSvc.getGradient("blue")
        };
    }
    onResize(event) {
        this.getcolumnWidth();
    }
}
