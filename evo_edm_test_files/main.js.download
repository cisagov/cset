        dialogRef.componentInstance.confirmMessage =
            "Are you sure you want to delete '" + s.fullName + "?'";
        dialogRef.afterClosed().subscribe(result => {
            if (result) {
                this.dropSet(s.setName);
            }
        });
        //});
    }
    dropSet(setName) {
        this.setBuilderSvc.deleteSet(setName).subscribe((response) => {
            // display any messages
            if (response.errorMessages.length > 0) {
                let msg = "";
                response.errorMessages.forEach(element => {
                    msg += element + "<br>";
                });
                this.dialog.open(_dialogs_alert_alert_component__WEBPACK_IMPORTED_MODULE_2__["AlertComponent"], {
                    data: {
                        messageText: msg
                    }
                });
            }
            // refresh page
            this.getStandards();
        }, error => {
            this.dialog
