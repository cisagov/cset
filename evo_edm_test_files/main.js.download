                r.salLevels.push(level);
                state = true;
            }
        }
        else if (a >= 0) {
            r.salLevels = r.salLevels.filter(x => x !== level);
            state = false;
        }
        this.setBuilderSvc.setSalLevel(r.requirementID, 0, level, state).subscribe();
    }
    /**
     * Indicates if no SAL levels are currently selected for the question.
     */
    missingSAL(r) {
        if (!r) {
            return false;
