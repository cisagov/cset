                color = "rgb(75,103,176)";
                break;
            }
            case 'PR': {
                color = "rgb(125,37,125)";
                break;
            }
            case 'DE': {
                color = "rgb(225,203,0)";
                break;
            }
            case 'RS': {
                color = "rgb(237,34,36)";
                break;
            }
            case 'RC': {
                color = "rgb(73,128,59)";
                break;
            }
        }
        let retVal = {
            'background-color': `${color}`
        };
        return retVal;
    }
