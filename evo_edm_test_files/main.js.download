class AssessmentDemographicsComponent {
    constructor(demoSvc, assessSvc) {
        this.demoSvc = demoSvc;
        this.assessSvc = assessSvc;
        this.demographicData = {};
    }
    ngOnInit() {
        this.demoSvc.getAllSectors().subscribe((data) => {
            this.sectorsList = data;
        }, error => {
            console.log('Error Getting all sectors: ' + error.name + error.message);
            console.log('Error Getting all sectors (cont): ' + error.stack);
        });
        this.demoSvc.getAllAssetValues().subscribe((data) => {
            this.assetValues = data;
        }, error => {
            console.log('Error Getting all asset values: ' + error.name + error.message);
            console.log('Error Getting all asset values (cont): ' + error.stack);
        });
        this.demoSvc.getSizeValues().subscribe((data) => {
            this.sizeList = data;
        }, error => {
            console.log('Error Getting size values: ' + error.name + error.message);
            console.log('Error Getting size values (cont): ' + error.stack);
        });
        if (this.demoSvc.id) {
            this.getDemographics();
        }
        this.refreshContacts();
        this.getOrganizationTypes();
    }
    onSelectSector(sectorId) {
        this.populateIndustryOptions(sectorId);
        // invalidate the current Industry, as the Sector list has just changed
        this.demographicData.industryId = null;
        this.updateDemographics();
    }
    getDemographics() {
        this.demoSvc.getDemographic().subscribe((data) => {
            this.demographicData = data;
            // populate Industry dropdown based on Sector
            this.populateIndustryOptions(this.demographicData.sectorId);
        }, error => console.log('Demographic load Error: ' + error.message));
    }
    getOrganizationTypes() {
        this.assessSvc.getOrganizationTypes().subscribe((data) => {
            this.orgTypes = data;
        });
    }
    refreshContacts() {
        if (this.assessSvc.id()) {
            this.assessSvc
                .getAssessmentContacts()
                .then((data) => {
                this.contacts = data.contactList;
            });
        }
    }
    populateIndustryOptions(sectorId) {
        if (!sectorId) {
            return;
        }
        this.demoSvc.getIndustry(sectorId).subscribe((data) => {
            this.industryList = data;
        }, error => {
            console.log('Error Getting Industry: ' + error.name + error.message);
            console.log('Error Getting Industry (cont): ' + error.stack);
        });
    }
    changeAssetValue(event) {
        this.demographicData.assetValue = event.target.value;
        this.updateDemographics();
    }
    changeOrgType(event) {
        this.demographicData.organizationType = event.target.value;
        this.updateDemographics();
    }
    changeFacilitator(event) {
        this.demographicData.facilitator = event.target.value;
        this.updateDemographics();
    }
    changeOrgName(event) {
        this.demographicData.organizationName = event.target.value;
        this.updateDemographics();
    }
    changeAgency(event) {
        this.demographicData.agency = event.target.value;
        this.updateDemographics();
    }
    changePointOfContact(event) {
        this.demographicData.pointOfContact = event.target.value;
        this.updateDemographics();
    }
    changeIsScoped(event) {
        //this.demographicData.isScoped = event.target.value;
        this.updateDemographics();
    }
    changeSize(event) {
        this.demographicData.size = event.target.value;
        this.updateDemographics();
    }
    update(event) {
        this.updateDemographics();
    }
    updateDemographics() {
        this.demoSvc.updateDemographic(this.demographicData);
    }
}
