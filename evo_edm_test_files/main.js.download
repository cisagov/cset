class SalGenComponent {
    constructor(assessSvc, route, salsSvc) {
        this.assessSvc = assessSvc;
        this.route = route;
        this.salsSvc = salsSvc;
    }
    ngOnInit() {
        this.salsSvc.getGenSalDescriptions().subscribe((data) => {
            this.sliders = data;
            this.sliders.forEach(s => {
                s.onSite.options = {
                    floor: s.onSite.min,
                    ceil: s.onSite.max,
                    showTicks: true,
                    showTicksValues: false,
                    showSelectionBar: true,
                    getLegend: (v) => {
                        return s.onSite.values[v];
                    }
                };
                s.offSite.options = {
                    floor: s.offSite.min,
                    ceil: s.offSite.max,
                    showTicks: true,
                    showTicksValues: false,
                    showSelectionBar: true,
                    getLegend: (v) => {
                        return s.offSite.values[v];
                    }
                };
            });
        }, error => {
            console.log('Error Getting gensal descriptions: ' + error.name + error.message);
            console.log('Error gensal descriptions: ' + error.stack);
        });
        // retrieve the existing sal_selection for this assessment
        this.salsSvc.getSalSelection().subscribe((data) => {
            this.salsSvc.selectedSAL = data;
        }, error => {
            console.log('Error Getting all standards: ' + error.name + error.message);
            console.log('Error Getting all standards: ' + error.stack);
        });
    }
    /**
     *
     */
    valueChange(event, slidername) {
        const Slider_Value = event;
        this.salsSvc.getSaveGenSal((this.assessSvc.id()), Slider_Value, slidername).subscribe((data) => {
            this.salsSvc.selectedSAL.selected_Sal_Level = data;
        }, error => {
            console.log('Error saving gensal: ' + error.name + error.message);
            console.log('Error saving gensal: ' + error.stack);
        });
    }
    /**
     *
     */
    saveLevel(level) {
        this.salsSvc.selectedSAL.selectedSALOverride = true;
        this.salsSvc.selectedSAL.selected_Sal_Level = level;
        this.salsSvc.updateStandardSelection(this.salsSvc.selectedSAL).subscribe((data) => {
            this.salsSvc.selectedSAL = data;
        }, error => {
            console.log('Error setting sal level: ' + error.name + error.message);
            console.log('Error setting sal level: ' + error.stack);
        });
    }
}
