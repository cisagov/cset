class EdmDeficiencyComponent {
    constructor(analysisSvc, reportSvc, configSvc, titleService, maturitySvc) {
        this.analysisSvc = analysisSvc;
        this.reportSvc = reportSvc;
        this.configSvc = configSvc;
        this.titleService = titleService;
        this.maturitySvc = maturitySvc;
    }
    ngOnInit() {
        this.titleService.setTitle("Deficiency Report - EDM");
        this.maturitySvc.getMaturityDeficiency("EDM").subscribe((r) => {
            this.response = r;
        }, error => console.log('Deficiency Report Error: ' + error.message));
    }
    getQuestion(q) {
        return q.split(/(?<=^\S+)\s/)[1];
    }
