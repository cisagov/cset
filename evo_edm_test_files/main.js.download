class SetListComponent {
    constructor(setBuilderSvc, authSvc, router, dialog) {
        this.setBuilderSvc = setBuilderSvc;
        this.authSvc = authSvc;
        this.router = router;
        this.dialog = dialog;
    }
    ngOnInit() {
        this.authSvc.checkLocal().then();
        this.getStandards();
    }
    getStandards() {
        this.setBuilderSvc.getCustomSetList().subscribe((response) => {
            this.setDetailList = response;
        }, error => console.log("Unable to get Custom Standards: " +
            error.message));
    }
    cloneSet(setName) {
        this.setBuilderSvc.cloneCustomSet(setName).subscribe((response) => {
            sessionStorage.setItem('setName', response.setName);
            this.router.navigate(['/set-detail', response.setName]);
        });
    }
    /**
     * Deletes the set after confirmation.
     */
    deleteSet(s) {
        // See if any questions originated from this set
