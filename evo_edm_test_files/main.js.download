        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementStart"](132, "p");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](133, "Each practice question contains a 3-point response scale to evaluate the degree to which the organization has implemented each practice.\u00A0 Each question has three possible answers: \u201CYes\u201D, \u201CIncomplete\u201D, and \u201CNo\u201D: ");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
