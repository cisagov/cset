                }
                if (e.status === 401) {
                    console.log('Error 401! Ejecting to login page!');
                }
                if (e.status === 500 || (e.error && e.error.ExceptionMessage === 'JWT invalid')) {
                    console.log(e.error.ExceptionMessage);
                    console.log('JWT Invalid. logging out.');
                }
                sessionStorage.clear();
