     */
    addDeleteReference(reqId, docId, isSourceDoc, sectionRef, adddelete) {
        if (docId === 0) {
            if (isSourceDoc) {
                this.sourceDocMissing = true;
            }
            else {
                this.resourceDocMissing = true;
            }
            return;
        }
        this.sourceDocMissing = false;
        this.resourceDocMissing = false;
        if (sectionRef.startsWith("#")) {
