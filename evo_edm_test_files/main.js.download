class EdmRelationshipComponent {
    constructor(maturitySvc) {
        this.maturitySvc = maturitySvc;
    }
    ngOnInit() {
    }
    ngOnChanges() {
        this.getEdmScores();
    }
    getEdmScores() {
        if (!!this.section) {
            this.maturitySvc.getEdmScores(this.section).subscribe((r) => {
                if (this.section == "MIL") {
                    r = r.filter(function (value, index, arr) { return value.parent.title_Id != "MIL1"; });
                }
                this.scores = r;
            }, error => console.log('RF Error: ' + error.message));
        }
    }
    getEdmScoreStyle(score) {
        switch (score.toLowerCase()) {
            case 'red': return 'red-score';
            case 'yellow': return 'yellow-score';
            case 'green': return 'green-score';
            case 'lightgray': return 'light-gray-score';
            default: return 'default-score';
        }
    }
}
