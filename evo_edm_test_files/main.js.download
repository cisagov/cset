class CmmcLevelResultsComponent {
    constructor(navSvc, maturitySvc, titleService) {
        this.navSvc = navSvc;
        this.maturitySvc = maturitySvc;
        this.titleService = titleService;
        this.initialized = false;
        this.dataError = false;
        this.whiteText = "rgba(255,255,255,1)";
        this.blueText = "rgba(31,82,132,1)";
    }
    ngOnInit() {
        this.maturitySvc.getResultsData('sitesummarycmmc').subscribe((r) => {
            this.response = r;
            if (r.maturityModels) {
                r.maturityModels.forEach(model => {
                    if (model.maturityModelName === 'CMMC') {
                        this.cmmcModel = model;
                    }
                });
                window.dispatchEvent(new Event('resize'));
            }
            this.initialized = true;
        }, error => {
            this.dataError = true;
            this.initialized = true;
            console.log('Site Summary report load Error: ' + error.message);
        }), (finish) => {
        };
    }
