class MaturityQuestionsComponent {
    constructor(assessSvc, configSvc, maturitySvc, questionsSvc, maturityFilteringSvc, filterSvc, glossarySvc, navSvc, dialog) {
        this.assessSvc = assessSvc;
        this.configSvc = configSvc;
        this.maturitySvc = maturitySvc;
        this.questionsSvc = questionsSvc;
        this.maturityFilteringSvc = maturityFilteringSvc;
        this.filterSvc = filterSvc;
        this.glossarySvc = glossarySvc;
        this.navSvc = navSvc;
        this.dialog = dialog;
        this.groupings = null;
        this.pageTitle = '';
        this.modelName = '';
        this.questionsAlias = '';
        this.showTargetLevel = false; // TODO: set this from a new column in the DB
        this.loaded = false;
        if (this.assessSvc.assessment == null) {
            this.assessSvc.getAssessmentDetail().subscribe((data) => {
                this.assessSvc.assessment = data;
            });
        }
        sessionStorage.setItem("questionSet", "Maturity");
    }
    ngOnInit() {
        this.loadQuestions();
        this.assessSvc.currentTab = 'questions';
    }
    /**
     *
     */
    ngAfterViewInit() {
    }
    /**
     * Returns the URL of the Questions page in the user guide.
     */
    helpDocUrl() {
        return this.configSvc.docUrl + 'htmlhelp/question_details__resources__and_comments.htm';
    }
    /**
     * Retrieves the complete list of questions
     */
    loadQuestions() {
        const magic = this.navSvc.getMagic();
        this.groupings = null;
        this.maturitySvc.getQuestionsList(this.configSvc.acetInstallation, false).subscribe((response) => {
            this.modelName = response.modelName;
            this.questionsAlias = response.questionsAlias;
            this.groupings = response.groupings;
            this.assessSvc.assessment.maturityModel.maturityTargetLevel = response.maturityTargetLevel;
            this.assessSvc.assessment.maturityModel.answerOptions = response.answerOptions;
            this.filterSvc.answerOptions = response.answerOptions;
            this.pageTitle = this.questionsAlias + ' - ' + this.modelName;
            this.glossarySvc.glossaryEntries = response.glossary;
            this.loaded = true;
            this.refreshQuestionVisibility();
        }, error => {
            console.log('Error getting questions: ' +
                error.name +
                error.message);
            console.log('Error getting questions: ' + error.stack);
        });
    }
    /**
       * Controls the mass expansion/collapse of all subcategories on the screen.
       * @param mode
       */
    expandAll(mode) {
        this.groupings.forEach((g) => {
            this.recurseExpansion(g, mode);
        });
    }
    /**
     * Groupings may be several levels deep so we need to recurse.
     */
    recurseExpansion(g, mode) {
        g.expanded = mode;
        g.subGroupings.forEach((sg) => {
            this.recurseExpansion(sg, mode);
        });
    }
    /**
     *
     */
    showFilterDialog() {
        // show the 'above target level' filter option for CMMC
        let show = this.modelName === 'CMMC';
        this.filterDialogRef = this.dialog.open(_dialogs_question_filters_question_filters_component__WEBPACK_IMPORTED_MODULE_6__["QuestionFiltersComponent"], {
            data: {
                showFilterAboveTargetLevel: show
            }
        });
        this.filterDialogRef.componentInstance.filterChanged.asObservable().subscribe(() => {
            this.refreshQuestionVisibility();
        });
        this.filterDialogRef
            .afterClosed()
            .subscribe(() => {
            this.refreshQuestionVisibility();
        });
    }
    /**
   * Re-evaluates the visibility of all questions/subcategories/categories
   * based on the current filter settings.
   */
    refreshQuestionVisibility() {
        this.maturityFilteringSvc.evaluateFilters(this.groupings.filter(g => g.groupingType === 'Domain'));
    }
    /**
     *
     * @returns
     */
    areGroupingsVisible() {
        return this.groupings.some(g => g.visible);
    }
}
