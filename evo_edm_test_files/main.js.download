class AssessmentDocumentsComponent {
    constructor(dialog, configSvc, authSvc, assessSvc, fileSvc) {
        this.dialog = dialog;
        this.configSvc = configSvc;
        this.authSvc = authSvc;
        this.assessSvc = assessSvc;
        this.fileSvc = fileSvc;
        this.documents = null;
    }
    ngOnInit() {
        this.assessSvc.getAssessmentDocuments().subscribe((response) => {
            this.documents = response;
        });
    }
    download(doc) {
        // get short-term JWT from API
        this.authSvc.getShortLivedToken().subscribe((response) => {
            const url = this.fileSvc.downloadUrl + doc.document_Id + "?token=" + response.token;
            window.open(url, "_blank");
        });
    }
    close() {
        return this.dialog.close();
    }
}
