        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](138, "Yes");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](139, " \u2013 the organization fully performs the activity specified in the question.");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
