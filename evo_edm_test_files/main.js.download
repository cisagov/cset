class SelectAssessmentsComponent {
    /**
     * CTOR
     * @param assessmentSvc
     * @param authSvc
     */
    constructor(dialog, assessmentSvc, authSvc, aggregationSvc) {
        this.dialog = dialog;
        this.assessmentSvc = assessmentSvc;
        this.authSvc = authSvc;
        this.aggregationSvc = aggregationSvc;
        this.aggregation = {};
    }
    ngOnInit() {
        // get my assessment list
        this.getAssessmentsForUser();
    }
    getAssessmentsForUser() {
        this.assessmentSvc.getAssessments().subscribe((resp) => {
            this.assessments = resp;
            this.aggregationSvc.getAssessments().subscribe((resp2) => {
                this.aggregation = resp2.aggregation;
                resp2.assessments.forEach(selectedAssess => {
                    this.assessments.find(x => x.assessmentId === selectedAssess.assessmentId).selected = true;
                });
            });
        }, error => console.log("Unable to get Assessments for " +
            this.authSvc.email() +
            ": " +
            error.message));
    }
    /**
     * Call the API to manage connections between aggregation and assessment.
     * @param event
     * @param assessment
     */
    toggleSelection(event, assessment) {
        console.log(assessment);
        this.aggregationSvc.saveAssessmentSelection(event.target.checked, assessment).subscribe((resp) => {
            this.aggregation = resp;
        });
    }
    /**
     *
     */
    close() {
        return this.dialog.close();
    }
}
