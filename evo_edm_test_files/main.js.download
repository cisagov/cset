        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementStart"](104, "li");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](105, "Organizations that have already adopted basic and intermediate level RRA practices and are looking to improve their response to ransomware threats should focus on adopting the practices in the Advanced Tier.");
