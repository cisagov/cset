class ChangePasswordComponent {
    constructor(auth, router, dialogRef, data) {
        this.auth = auth;
        this.router = router;
        this.dialogRef = dialogRef;
        this.data = data;
        this.message = '';
        this.warning = false;
        this.cpwd = {};
        this.forceChangePassword = false;
        this.msgChangeTempPw = 'Temporary password must be changed on first logon.';
        this.cpwd.primaryEmail = data.primaryEmail;
        this.cpwd.appCode = _environments_environment__WEBPACK_IMPORTED_MODULE_2__["environment"].appCode;
        this.warning = data.warning;
    }
    ngOnInit() {
        if (this.warning) {
            this.message = this.msgChangeTempPw;
        }
    }
    onPasswordChangeClick(fReg) {
        if (fReg.valid) {
            this.auth.changePassword(this.cpwd).subscribe((response) => {
                console.log('changePassword:');
                console.log(response);
                this.dialogRef.close();
            }, error => {
                console.log('changePassword error');
                console.log(error);
                this.warning = true;
                this.message = error.error;
            });
        }
    }
    cancel() {
        this.dialogRef.close();
        // if canceling out of a change TEMP password, navigate back to the login
        // but if cancelling out of a NON-TEMP password change, don't do anything.
        if (this.warning && this.message === this.msgChangeTempPw) {
            this.auth.logout();
        }
    }
