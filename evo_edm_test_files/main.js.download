                vals["color_two"] = `rgba(97,153,206,${alpha})`;
                break;
            }
            case "blue-3": {
                vals["color_one"] = `rgba(120,151,156,${alpha})`;
                vals["color_two"] = `rgba(137,179,218,${alpha})`;
                break;
            }
            case "blue-4": {
                vals["color_one"] = `rgba(165,185,205,${alpha})`;
                vals["color_two"] = `rgba(176,204,230,${alpha})`;
                break;
            }
