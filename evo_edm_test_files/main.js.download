        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](101, "Organizations that are unfamiliar with ransomware and need to begin basic cyber hygiene safeguards against ransomware threats should focus on implementing the basic tier of practices.");
