        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](142, "Incomplete");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](143, " \u2013 the organization partially performs the activity");
