                retVal["border-bottom-width"] = "1px";
                break;
            case "2":
                retVal["background-color"] = "#dcd9ec";
                retVal["color"] = "#444";
                break;
            case "3":
                retVal["background-color"] = "#9b99c3";
                retVal["color"] = "#fff";
                break;
            case "4":
                retVal["background-color"] = "#504d99";
                retVal["color"] = "#fff";
                break;
            case "5":
