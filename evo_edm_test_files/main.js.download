        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](204, "Practices are either performed (answer =\u201DYes\u201D), incompletely performed (answer = \u201CIncomplete\u201D), or not performed (answer = \u201CNo\u201D).");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementStart"](205, "li", 9);
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](206, "A goal is achieved only if all practices are performed.");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementEnd"]();
