class CrrCommentsMarkedComponent {
    constructor(analysisSvc, reportSvc, configSvc, titleService, maturitySvc, sanitizer) {
        this.analysisSvc = analysisSvc;
        this.reportSvc = reportSvc;
        this.configSvc = configSvc;
        this.titleService = titleService;
        this.maturitySvc = maturitySvc;
        this.sanitizer = sanitizer;
        this.response = null;
    }
    ngOnInit() {
        this.titleService.setTitle("Comments Report - CRR");
        this.maturitySvc.getCommentsMarked('CRR').subscribe((r) => {
            this.response = r;
        }, error => console.log('Comments Marked Report Error: ' + error.message));
    }
}
