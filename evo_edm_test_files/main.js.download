        if (!this.setDetail.fullName || this.setDetail.fullName.length === 0
            || !this.setDetail.shortName || this.setDetail.shortName.length === 0
            || !this.setDetail.description || this.setDetail.description.length === 0) {
            return false;
        }
        return true;
