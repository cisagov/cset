%200.389,5.903%200,9.051%200,12.2L0,15.152C0,18.3%200.389,21.448%200.389,21.448%200.389,21.448%200.769,24.128%201.935,25.31%203.415,26.858%205.359,26.81%206.225,26.972%209.337,27.27%2019.452,27.364%2019.452,27.364%2019.452,27.364%2027.628,27.352%2033.071,26.958%2033.832,26.866%2035.491,26.858%2036.97,25.31%2038.136,24.128%2038.516,21.448%2038.516,21.448%2038.516,21.448%2038.905,18.3%2038.905,15.152L38.905,12.2C38.905,9.051,38.516,5.903,38.516,5.903%20M15.436,18.728L15.434,7.797%2025.946,13.282z'/%3E%3C/svg%3E\");\n}\n.gauge {\n  margin-left: 2em;\n  width: 80px;\n  height: 40px;\n}\n#FixedHolder {\n  background: #fff;\n  border-top-left-radius: 8px;\n  border-bottom-left-radius: 8px;\n  box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.2);\n  text-align: center;\n  justify-content: center;\n  position: fixed;\n  right: 0;\n  top: 140px;\n  width: 8em;\n  margin-top: -2.5em;\n  margin-right: 0;\n  z-index: 1000;\n}\n#FixedHolder .item {\n  flex-direction: row;\n}\n.gauges-footer {\n  display: none;\n  color: #fff;\n  background-color: #285464;\n  background-color: #3b7887;\n  border-top: 1px solid #888;\n  border-left: 1px solid #888;\n  border-right: 1px solid #888;\n  border-top-left-radius: 5px;\n  border-top-right-radius: 5px;\n  position: fixed;\n  bottom: 0;\n  width: 90vw;\n  z-index: 999;\n  padding: 8px 28px;\n  margin-bottom: 28px;\n}\n.gauges-footer > div {\n  margin: 0 0.2em;\n}\n@media only screen and (max-width: 991px) {\n  #FixedHolder {\n    display: none;\n  }\n\n  .gauges-footer {\n    display: flex;\n    flex-direction: row;\n    justify-content: space-between;\n  }\n}\n/* --- Blues --- */\n/* --- button styles --- */\n*:not(font) {\n  font-family: \"Roboto\", sans-serif;\n}\nbody {\n  background-color: #FAFAFA;\n  outline: none;\n}\n:focus {\n  outline: none;\n}\n*:focus {\n  outline: none !important;\n}\n.nav-link:focus {\n  border: 1px solid #3B68AA !important;\n  border-radius: 4px !important;\n  text-decoration: none !important;\n}\na:focus {\n  text-decoration: underline !important;\n}\na {\n  padding: 2px;\n}\ninput[type=checkbox]:focus {\n  border: 1px solid #8BB4F8 !important;\n  box-shadow: 0px 0px 1px 2px #8BB4F8 !important;\n  border-radius: 4px;\n}\n.btn:focus {\n  outline: dashed 2px lightgrey;\n  outline-offset: 5px;\n}\n.gutter-background {\n  background-image: url(\"/assets/images/bgGradient1.png\");\n  background-repeat: repeat-x;\n  background-position: top left;\n  background-size: auto 100%;\n}\na, a:not([href]) {\n  color: #1a53ff;\n  cursor: pointer;\n}\na:not([href]).btn-link-dark:hover {\n  color: #0056b3;\n}\n.btn-link, a:not([href]).btn-link,\n.btn-link-dark, a:not([href]).btn-link-dark {\n  color: #1a53ff;\n  font-weight: 500;\n  border: none;\n}\n.btn-link-dark:hover, a:not([href]).btn-link-dark:hover,\n.icon-link-button-text-dark:hover {\n  text-decoration: underline;\n}\n.icon-link-button-dark {\n  color: #052637;\n}\n.icon-link-button-dark:hover {\n  color: #000000;\n}\n.btn-link-subtle {\n  font-weight: 400;\n  color: #052637;\n  background-color: transparent;\n}\n.btn-link-subtle:hover {\n  color: #052637;\n  -webkit-text-decoration: underline dotted;\n          text-decoration: underline dotted;\n  background-color: transparent;\n  border-color: transparent;\n}\n.btn-link-subtle:focus,\n.btn-link-subtle.focus {\n  -webkit-text-decoration: underline dotted;\n          text-decoration: underline dotted;\n  border-color: transparent;\n  box-shadow: none;\n}\n.btn-link-subtle:disabled,\n.btn-link-subtle.disabled {\n  color: #6c757c;\n  pointer-events: none;\n}\n.no-underline {\n  text-decoration: none !important;\n}\nh2,\nh3,\nh4 {\n  color: #052637;\n  margin-top: 0;\n}\n.heading-color {\n  color: #052637;\n}\nlabel[required]::after {\n  content: \" *\";\n  font-weight: bold;\n  color: red;\n}\n.dhs-seal-background {\n  background-image: url(\"/assets/images/CISA_Logo_1831px.png\");\n  background-repeat: no-repeat;\n  background-position: center bottom;\n  background-size: contain;\n  position: absolute;\n  width: 300px;\n  height: 300px;\n  z-index: -1;\n  bottom: 80px;\n  left: 0;\n  right: 0;\n  margin: 0 auto;\n  opacity: 0.1;\n}\n.bg-semi-trans {\n  background-color: rgba(255, 255, 255, 0.6);\n}\n.z-10 {\n  z-index: 10;\n}\n/* --- header --- */\n.cset-header {\n  background-color: #052637;\n}\n/* --- footer --- */\n/* -- footer styling -- */\n.footer .card {\n  border: none;\n  flex: 1 1 auto;\n}\n.footer .card-header {\n  padding: 0rem;\n}\n.footer .card-body {\n  padding: 0rem;\n}\n.footer .btn-link,\n.footer-section-1 a {\n  color: #e6e6e6;\n}\n.footer-section-1 a:hover {\n  color: #ffffff;\n}\n.footer-section-1 {\n  background-color: #052637;\n  color: #e6e6e6;\n}\n.footer-section-2 {\n  color: #FAFAFA;\n  background-color: #052637;\n  line-height: 2em;\n}\n.footer-section-2 a {\n  color: #FAFAFA;\n}\n.footer .card .card-header h5 {\n  display: flex;\n  justify-content: center;\n  flex: 1 1 auto;\n  cursor: pointer;\n}\n.footer .card .card-header h5 button:first-child {\n  width: 100%;\n  cursor: inherit;\n}\n.cset-footer-expand-button {\n  color: #e6e6e6;\n  background-color: transparent;\n  border: none;\n  cursor: pointer;\n}\n.cset-footer-expand-button:hover,\n.cset-footer-expand-button:focus,\n.footer .btn-link:hover,\n.footer .btn-link:focus {\n  text-decoration: none;\n  color: #ffffff;\n}\n.footer .bg-primary {\n  background-color: #052637 !important;\n}\n.footer .card-header:first-child {\n  border-radius: 0rem;\n  text-align: center;\n}\n.f1-head {\n  margin: 0.5rem 0;\n  font-size: 1.3em;\n}\n.white-panel {\n  background-color: #FAFAFA;\n  padding: 2rem;\n  color: #404040;\n}\n.white-dialog {\n  background-color: #ffffff;\n  color: #404040;\n}\n.quick-info-container {\n  border-radius: 4px;\n  background-color: #367190;\n  color: #F2F2F2;\n}\n.quick-info-stats-container,\n.standards-stats {\n  padding-top: 2px;\n  padding-bottom: 2px;\n  border-radius: 4px;\n  text-align: center;\n  background-color: #FAFAFA;\n  color: #262626;\n}\n.no-padding {\n  padding-right: 0 !important;\n  padding-left: 0 !important;\n}\ninput[type=email]:focus,\ninput[type=password]:focus,\ninput[type=text]:focus {\n  background-color: #FAFAFA;\n  border: 2px solid #8FB0C1;\n}\ninput[type=number]::-webkit-inner-spin-button,\ninput[type=number]::-webkit-outer-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\ninput[type=number] {\n  -moz-appearance: textfield;\n}\ntable.cset-table {\n  width: 100%;\n  color: #052637;\n}\ntable.cset-table tr:nth-child(even) {\n  background: #F2F2F2;\n}\ntable.cset-table tr:nth-child(odd) {\n  background: #FAFAFA;\n}\ntable.cset-table td,\ntable.cset-table th {\n  padding: 0.5rem 0.75rem;\n}\ntable.cset-table th {\n  background-color: #367190;\n  color: #FAFAFA;\n  font-weight: 500;\n}\ntable.cset-table tr.total-row {\n  border-top: 1px solid #c8c8c8;\n  border-bottom: 1px solid #c8c8c8;\n  background-color: inherit !important;\n}\ntable.assessment-summary {\n  width: 100%;\n  color: #052637;\n}\ntable.assessment-summary tr:nth-child(even) {\n  background: #F2F2F2;\n}\ntable.assessment-summary tr:nth-child(odd) {\n  background: #FAFAFA;\n}\ntable.assessment-summary th:nth-child(1) {\n  padding-left: 12px;\n}\ntable.assessment-summary td,\ntable.assessment-summary th {\n  padding: 0.5em 0.4em 0.5em 0;\n}\ntable.assessment-summary th {\n  background-color: #367190;\n  color: #FAFAFA;\n  font-weight: 500;\n}\n@media only screen and (max-width: 767px) {\n  .navbar-collapse.collapse.show {\n    background-color: #052637;\n    z-index: 10000;\n    padding: 10px;\n  }\n}\n/*\n@media only screen and (max-width: 1200px) {\n  table.assessment-summary td > button > span {\n    display: none;\n  }\n}\n@media only screen and (max-width: 992px) {\n  table.assessment-summary td > button > span {\n    display: none;\n  }\n}\n@media only screen and (max-width: 767px) {\n  table.assessment-summary td:nth-child(2),\n  table.assessment-summary th:nth-child(2) {\n    display: none;\n  }\n\n  table.assessment-summary td:nth-child(3),\n  table.assessment-summary th:nth-child(3) {\n    display: none;\n  }\n}\n\n@media only screen and (max-width: 360px) {\n  table.assessment-summary td:nth-child(2),\n  table.assessment-summary th:nth-child(2) {\n    display: none;\n  }\n  table.assessment-summary td:nth-child(3),\n  table.assessment-summary th:nth-child(3) {\n    display: none;\n  }\n  table.assessment-summary td:nth-child(4),\n  table.assessment-summary th:nth-child(4) {\n    display: none;\n  }\n}*/\ntable.paddingBetweenCols td,\ntable.paddingBetweenCols th {\n  padding: 0 15px 10px;\n}\ntable.td-align-top td {\n  vertical-align: top;\n}\n.reference-table {\n  width: 100%;\n  margin-bottom: 10px;\n}\n.reference-table td,\n.reference-table th {\n  padding-right: 10px;\n}\n.irp-table th, .irp-table td {\n  vertical-align: top;\n  padding: 0.5rem 0.3rem;\n}\n.login-logo {\n  margin: 3em 0 3em 3em;\n}\n@media only screen and (max-width: 992px) {\n  .login-logo {\n    padding-top: 1em;\n  }\n}\n/* override a few bootstrap classes */\n.form-control {\n  color: #404040;\n}\n.btn-primary {\n  color: #F2F2F2;\n  background-color: #367190;\n  border-color: #367190;\n}\n.btn-primary:hover {\n  background-color: #052637;\n  border-color: #367190;\n  color: #ffffff;\n}\n.btn.disabled.btn-primary,\n.btn:disabled.btn-primary {\n  cursor: not-allowed;\n  box-shadow: none;\n  opacity: 1;\n  background-color: #8c8c8c;\n  color: #bfbfbf;\n  border-color: #8c8c8c;\n}\n.btn-secondary {\n  background-color: #d9d9d9;\n  color: #262626;\n}\n.btn-secondary:hover {\n  background-color: #367190;\n  border-color: #367190;\n  color: #ffffff;\n  fill: #ffffff;\n}\n.btn-secondary > Label {\n  font-weight: 500;\n}\n.btn-secondary:hover > Label {\n  color: #ffffff;\n  fill: #ffffff;\n}\n.btn-secondary:disabled {\n  fill: #ffffff;\n}\n.btn-primary,\n.btn-success {\n  margin: 2px;\n}\n/* Answer option button styles */\n.btn-yes {\n  background-color: #ffffff;\n  border-color: #006000;\n  color: #006000;\n}\n.btn-yes.answer-selected,\n.btn-yes:hover {\n  background-color: #006000;\n  color: #ffffff;\n}\n.btn-yes.answer-selected:hover {\n  background-color: #004d00;\n}\n.btn-no {\n  background-color: #ffffff;\n  border-color: #990000;\n  color: #990000;\n}\n.btn-no.answer-selected:hover {\n  background-color: #660000;\n}\n.btn-no.answer-selected,\n.btn-no:hover {\n  background-color: #990000;\n  color: #ffffff;\n}\n.btn-na {\n  background-color: #ffffff;\n  border-color: #367190;\n  color: #367190;\n}\n.btn-na.answer-selected:hover {\n  background-color: #0A4B6E;\n}\n.btn-na.answer-selected,\n.btn-na:hover {\n  background-color: #367190;\n  color: #ffffff;\n}\n.btn-alt {\n  background-color: #ffffff;\n  border-color: #b17300;\n  color: #b17300;\n}\n.btn-alt.answer-selected:hover {\n  background-color: #805300;\n}\n.btn-alt.answer-selected,\n.btn-alt:hover {\n  background-color: #b17300;\n  color: #ffffff;\n}\n.btn-inc {\n  background-color: #ffffff;\n  border-color: #b17300;\n  color: #b17300;\n}\n.btn-inc.answer-selected:hover {\n  background-color: #805300;\n}\n.btn-inc.answer-selected,\n.btn-inc:hover {\n  background-color: #b17300;\n  color: #ffffff;\n}\n.btn-mfr {\n  background-color: #E8EFF2;\n  border-color: #404040;\n  color: #052637;\n}\n.btn-mfr:hover,\n.btn-mfr.answer-selected:hover {\n  background-color: #2c5c6d;\n  color: #ffffff;\n}\n.btn-mfr.answer-selected {\n  background-color: #eae894;\n  color: #262626;\n}\n.alt-text-required {\n  border: 2px solid red;\n}\n.alt-text-required-msg {\n  color: red;\n}\n.btn-sal-select {\n  background-color: transparent;\n  margin: 0 2px;\n}\n.btn-sal-select.active {\n  color: #ffffff;\n  background-color: #367190;\n}\n.sal-checkboxes input {\n  margin-right: 2px;\n}\n.sal-checkboxes label {\n  margin-right: 1rem;\n}\n/* round the inside corners of the 'inside' buttons of the group */\n.answer-group.btn-group > .btn {\n  border-radius: 4px !important;\n}\n.btn-group {\n  margin-bottom: 5px;\n}\n/* define a button style for a pill-style radio button */\n.btn-app-mode.active:hover {\n  background-color: #000000;\n  color: #ffffff;\n}\n.btn-app-mode {\n  background-color: transparent;\n  border-color: #367190;\n  color: #367190;\n}\n.btn-app-mode.active {\n  background-color: #367190;\n  color: #F2F2F2;\n}\n.btn-app-mode:hover {\n  background-color: #052637;\n  color: #ffffff;\n}\n.btn-pc-only {\n  display: inline-block;\n}\n.btn-mobile-only {\n  display: none;\n}\n@media only screen and (max-device-width: 667px) and (orientation: portrait) and (-webkit-min-device-pixel-ratio: 2) {\n  .btn-mobile-only {\n    display: inline-block;\n  }\n\n  .btn-pc-only {\n    display: none;\n  }\n}\n/* -- gauge styles -- */\n.lmhvh-display {\n  display: flex;\n  align-items: flex-end;\n  margin-bottom: 2em;\n}\n/* -- radio button styles -- */\n.btn-level {\n  background-color: #e6e6e6;\n  color: #052637;\n}\n.btn-level:hover {\n  background-color: #a6a6a6;\n  color: #052637;\n}\n.btn-level:not(.disabled).active,\n.btn-level:not(.disabled).activeLevel,\n.show > .btn-level.dropdown-toggle {\n  background-color: #367190;\n  color: #ffffff;\n}\n.gauge {\n  background-color: #ffffff;\n  fill: #052637;\n}\n.gaugesmall {\n  transform: scale(0.75);\n}\n/* slider bar styles */\n.irs-bar,\n.irs-bar-edge,\n.irs-single {\n  background: #4C819C;\n}\n.ngx-slider {\n  margin-bottom: 4rem !important;\n}\n.ngx-slider .ngx-slider-pointer, .ngx-slider .ngx-slider-selection {\n  background-color: #367190 !important;\n}\n.ngx-slider .ngx-slider-tick.ngx-slider-selected {\n  background: #367190 !important;\n}\n.ngx-slider .ngx-slider-active::after {\n  background: #8FB0C1 !important;\n}\n.ngx-slider .ngx-slider-tick-legend {\n  font-size: 0.7rem;\n}\n.ngx-slider .ngx-slider-bubble {\n  visibility: hidden !important;\n}\n.gen-sal-slider-group {\n  border: 1px solid #A5C0CD;\n  border-radius: 0.5rem;\n}\n.sal-slider-label {\n  display: inline-block;\n  font-size: 0.6em;\n  background: #4C819C;\n  color: white;\n  border-radius: 5px;\n  padding: 2px 8px;\n}\n.sal-slider-label + .sal-slider-label {\n  float: right;\n  color: black;\n  background: #D2DFE6;\n}\n.align-left {\n  text-align: left;\n}\n.align-right {\n  text-align: right;\n}\n.align-center {\n  text-align: center;\n}\n/* --- materials overrides --- */\n.mat-calendar-body-selected {\n  background-color: #052637;\n}\n.mat-tooltip {\n  font-size: 1em;\n  background-color: #d9d9d9 !important;\n  color: #262626 !important;\n  border-radius: 1em;\n  border: 1px solid #F2F2F2;\n}\nul.mat-tree-node {\n  display: block;\n}\n.side-nav-container .mat-tree-node {\n  min-height: 0;\n}\n.side-nav-container .mat-nested-tree-node > button > span,\n.side-nav-container .mat-tree-node > button > span {\n  display: block;\n}\n.side-nav-container .phase-node {\n  margin-top: 1rem;\n}\n.side-nav-container .phase-node > button > span {\n  font-size: 1.3rem;\n}\n.side-nav-container .current-node > button {\n  border: 1px solid #ffffff;\n}\n/* Allow autocomplete to be wider than its companion field */\n.cdk-overlay-pane {\n  width: auto !important;\n}\n.display-none {\n  display: none !important;\n}\n.display-hidden {\n  visibility: hidden !important;\n}\n.debug-highlight {\n  background-color: #fbe1c2;\n  padding: 3px 4px;\n  border-radius: 0.3rem;\n}\n/* --- spinner styles -- */\n.spinner-container {\n  padding: 8px;\n}\n.spinner-container > .spinner,\n.spinner-container > div {\n  border: 4px solid #F2F2F2;\n  border-radius: 50%;\n  border-top: 4px solid #052637;\n  width: 100px;\n  height: 100px;\n  -webkit-animation: spin-wait 1.3s linear infinite;\n  /* Safari */\n  animation: spin-wait 1.3s linear infinite;\n  margin-left: auto;\n  margin-right: auto;\n}\n.spinner-container.toc > .spinner,\n.spinner-container.toc > div {\n  border-top: 4px solid #6390A9;\n}\ndiv.spinner-size-50 {\n  max-width: 50px;\n  max-height: 50px;\n}\n/* Safari */\n@-webkit-keyframes spin-wait {\n  0% {\n    -webkit-transform: rotate(0deg);\n  }\n  100% {\n    -webkit-transform: rotate(360deg);\n  }\n}\n@keyframes spin-wait {\n  0% {\n    transform: rotate(0deg);\n  }\n  100% {\n    transform: rotate(360deg);\n  }\n}\n/* spinner fade animation */\n.spinner-fade-in {\n  opacity: 0 !important;\n  transition: 0.2s ease-in-out all;\n}\n.spinner-show {\n  opacity: 1 !important;\n}\n.spinner-hide {\n  display: none;\n}\nul.mat-tree-node {\n  display: block;\n}\nul.mat-tree-node mat-tree-node {\n  min-height: 0;\n}\n.in-page-message {\n  margin: 2em 0;\n  border: 1px solid #cccccc;\n  border-radius: 0.5em;\n  padding: 1em;\n}\n.question-filters input[type=checkbox] {\n  margin-right: 0.5em;\n}\n.question-filters > div > label {\n  font-weight: normal;\n  white-space: normal;\n}\n.question-filters > div {\n  display: flex;\n  flex-direction: row;\n  white-space: nowrap;\n  align-items: flex-start;\n}\n.filters-engaged {\n  background-color: #F9CE15;\n  margin-top: 0.2rem;\n  margin-bottom: 1rem;\n  padding: 0.6em;\n  width: 100%;\n  border-radius: 0.5em;\n  font-size: 1.4em;\n  font-weight: bold;\n  text-align: center;\n  color: #052637;\n}\n.default-mat-filter {\n  font-weight: 700 !important;\n  font-style: italic !important;\n  font-size: 1.1rem;\n}\n.parameter-orig-value {\n  font-size: 1.1em;\n  color: #052637;\n  margin: 10px 0;\n}\n.data-table {\n  border: 1px solid #ffffff;\n}\ntable.data-table {\n  width: 100%;\n  border: 2px solid #000000 !important;\n}\ntr.data-table:nth-child(even) {\n  background-color: #d9d9d9;\n}\ntd.data-table {\n  padding: 5px;\n  text-align: left;\n}\nth.data-table {\n  background: #052637;\n  color: #ffffff;\n  text-align: center;\n  padding: 10px;\n}\n.chart {\n  padding-bottom: 45px;\n  text-align: center;\n}\n.report-links button {\n  display: block;\n}\n.router-flex {\n  flex: 1 1 auto;\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  overflow: hidden;\n}\n.wrap-text {\n  /* These are technically the same, but use both */\n  overflow-wrap: break-word;\n  word-wrap: break-word;\n  /* This is the dangerous one in WebKit, as it breaks things wherever */\n  /* Instead use this non-standard one: */\n  word-break: normal;\n  /* Adds a hyphen where the word breaks, if supported (No Blink) */\n  -ms-hyphens: auto;\n  -webkit-hyphens: auto;\n  hyphens: auto;\n  white-space: normal;\n}\n.header-help {\n  color: #F2F2F2;\n}\n.logo-fill {\n  fill: #FAFAFA;\n}\n.nav-pills > li.active > a,\n.nav-pills > li.active > a:focus {\n  background-color: #367190;\n}\n.nav-pills > li.active > a:hover {\n  background-color: #6390A9;\n}\n.nav .open > a {\n  background-color: transparent;\n}\n.local-install {\n  background-color: #B06C23;\n  color: #F2F2F2;\n  font-weight: 600;\n}\n.nav > li > a:focus,\n.nav > li > a:hover {\n  background-color: transparent;\n  color: #ffffff;\n}\n.nav-tab {\n  background-color: #367190;\n  color: #F2F2F2;\n  width: 300px;\n  text-align: justify;\n}\n.nav-tab-collapsed {\n  background-color: #367190;\n  color: #F2F2F2;\n  text-align: center;\n}\n.nav-tabs {\n  height: 50px;\n  border: none;\n  background-color: #367190;\n}\nul.nav-tabs li.active {\n  background: #FAFAFA;\n}\nul.nav-tabs li.active button {\n  color: #367190;\n  fill: #367190;\n  font-weight: 600;\n  font-size: 1.2rem;\n  cursor: auto;\n}\nul.nav-tabs li.active button span:hover,\nul.nav-tabs li.active button:focus,\nul.nav-tabs li.active button:hover {\n  color: #052637;\n  text-decoration: none;\n}\nul.nav-tabs li button {\n  color: #F2F2F2;\n  font-weight: 500;\n  font-size: 1rem;\n}\nul.nav-tabs li button:focus,\nul.nav-tabs li button:hover {\n  color: #ffffff;\n}\nul.nav-tabs li.active button .tab-icon {\n  font-size: 1.6rem;\n}\n.fs-head-lock {\n  font-size: 2rem;\n}\n.fs-head-logo {\n  font-size: 4rem;\n}\n/* --- Navbar --- */\n.navbar {\n  margin-bottom: 0;\n  border-radius: 0;\n  min-height: auto;\n}\n.navbar-toggler-icon {\n  font-family: \"Material Icons\";\n  display: flex;\n  align-items: center;\n  flex: 0 0 auto;\n  padding: 5px;\n}\n#csetNavb