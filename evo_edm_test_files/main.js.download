class ModuleAddCloneComponent {
    constructor(data, setSvc, dialogRef) {
        this.data = data;
        this.setSvc = setSvc;
        this.dialogRef = dialogRef;
        this.warning = false;
        this.selectedSets = [];
        this.setNames = [];
    }
    /**
     *
     */
    ngOnInit() {
        const isName = (element) => element;
        this.warning = false;
        this.setSvc.getBaseSetsList(this.data.setName).subscribe((selectedList) => {
            this.setSvc.getNonCustomSets(this.data.setName).subscribe((response) => {
                this.setNames = response;
                selectedList.forEach(x => {
                    let index = this.setNames.findIndex((element) => { return element.setName == x; });
                    if (index > -1)
                        this.selectedSets.push(this.setNames[index]);
                });
            }, error => console.log("Unable to get Custom Standards: " +
                error.message));
        });
    }
    /**
     *
     */
    addSets() {
        this.setSvc.saveSets(this.data.setName, this.selectedSets).subscribe(() => {
            this.warning = false;
            this.dialogRef.close();
        }, error => {
            console.log("Unable to get Custom Standards: " + error.message);
            this.warning = true;
        });
    }
    /**
     *
     */
    cancel() {
        this.dialogRef.close();
    }
}
