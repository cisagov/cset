class FrameworkComponent {
    constructor(navSvc, assessSvc, frameworkSvc) {
        this.navSvc = navSvc;
        this.assessSvc = assessSvc;
        this.frameworkSvc = frameworkSvc;
    }
    ngOnInit() {
        this.loadFrameworks();
    }
    loadFrameworks() {
        this.frameworkSvc.getFrameworksList().subscribe((data) => {
            this.frameworks = data;
        }, error => {
            console.log('Error getting all frameworks: ' + error.name + error.message);
            console.log('Error getting all frameworks: ' + error.stack);
        });
    }
    submit(group, tier) {
        this.selectedTier = {
            tierType: group.tierType,
            tierName: tier.tierName
        };
        this.frameworkSvc.postSelections(this.selectedTier).subscribe();
    }
