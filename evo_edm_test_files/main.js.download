            var yesPercent = element.series.find(x => x.name == 'Yes').value;
            var goal = { name: element.name, value: Math.round(yesPercent) };
            goalList.push(goal);
        });
        this.complianceByGoal = goalList;
    }
    formatPercent(x) {
