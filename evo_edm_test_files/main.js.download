            }
            this.getStackBarChartData(sortedData[i], this.totalCMMCQuestions).forEach(element => {
                dataEle.unshift(element);
            });
            outputData.push(dataEle);
        }
        return outputData;
    }
    getComplianceLevelAcheivedData(data) {
        let acheivedLevel = 0;
