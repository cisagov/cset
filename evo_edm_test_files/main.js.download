        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementStart"](187, "td");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵtext"](188, "Indicates that all EDM Practices in a Domain are performed, planned, managed, monitored, controlled, and consistent across all internal constituencies who have a vested interest in the performance of the practice. A defined process or practice ensures that an enterprise benefits from consistent processes across organizational units and that lessons learned are shared across the enterprise. The MIL-5 level of maturity is sometimes more relevant for larger enterprises charged with managing or providing guidance to dispersed business units. At MIL-5, a process or practice ");
        _angular_core__WEBPACK_IMPORTED_MODULE_0__["ɵɵelementStart"](189, "ul");
