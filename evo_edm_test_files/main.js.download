        if (input.modelLevel < this.cmmcModel.targetLevel) {
            color = this.getGradient("blue");
        }
        else if (input.modelLevel == this.cmmcModel.targetLevel) {
            color = this.getGradient("green");
        }
        else {
            color = this.getGradient("grey");
        }
        let val = {
            width: `${width}%`,
            background: color
        };
        return val;
    }
