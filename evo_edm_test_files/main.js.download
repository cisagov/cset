class RankedQuestionsComponent {
    constructor(analysisSvc, assessSvc, navSvc, router, configSvc) {
        this.analysisSvc = analysisSvc;
        this.assessSvc = assessSvc;
        this.navSvc = navSvc;
        this.router = router;
        this.configSvc = configSvc;
        this.initialized = false;
    }
    ngOnInit() {
        this.docUrl = this.configSvc.docUrl;
        this.analysisSvc.getRankedQuestions().subscribe(x => this.setupTable(x));
    }
    setupTable(data) {
        this.initialized = false;
        this.dataRows = data;
        let i = 1;
        for (const row of this.dataRows) {
            row.rank = i++;
            switch (row.answerText) {
                case 'U':
                    row.displayAnswer = this.configSvc.answerLabels['U'];
                    break;
                case 'N':
                    row.displayAnswer = this.configSvc.answerLabels['N'];
                    break;
            }
        }
        this.initialized = true;
    }
}
