        */
        for (let i = 0; i < len; i += 1) {
            newLen = newArray.length;
            for (let j = 0; j < newLen; j += 1) {
                if (newArray[j] === arrayName[i]) {
                    found_duplicate = true;
                    break;
                }
            }
            found_duplicate ? found_duplicate = false : newArray.push(arrayName[i]);
