class EdmBlocksCompactComponent {
    /**
     * Constructor
     */
    constructor(maturitySvc) {
        this.maturitySvc = maturitySvc;
    }
    /**
     *
     */
    ngOnInit() {
    }
    /**
     *
     */
    ngOnChanges() {
        this.getEdmScores();
    }
    /**
     *
     */
    getEdmScores() {
        if (!!this.section) {
            this.maturitySvc.getEdmScores(this.section).subscribe((r) => {
                this.scores = r;
                // now we have to manipulate the result.  
                // Remove 'parent' questions and rename their children with the parent's number
                this.scores.forEach(goal => {
                    var _a;
                    for (let i = 0; i < goal.children.length; i++) {
                        const question = goal.children[i];
