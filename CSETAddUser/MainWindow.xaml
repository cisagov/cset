<Window x:Class="CSETAddUser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CSETAddUser"
        mc:Ignorable="d"
        Title="Add a CSET User" Width="480" MinWidth="360" SizeToContent="Height">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Command="{Binding SomeCommand}" Key="Enter"></KeyBinding>
    </Window.InputBindings>
    <StackPanel Margin="15">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,15">
            Adds a user directly to the CSET database without sending an email. If an account
            with the same email address already exists, its name and password are replaced.
            New accounts are standard users and are not asked to change their password at
            first sign-in. The database is set by CSET_DB in appsettings.json.
        </TextBlock>

        <Label Content="First Name"/>
        <TextBox Name="txtFirstName"/>

        <Label Content="Last Name"/>
        <TextBox Name="txtLastName"/>

        <Label Content="Email"/>
        <TextBox Name="txtEmail"/>

        <Label Content="Password"/>
        <PasswordBox Name="Password1"/>

        <Label Content="Confirm Password"/>
        <PasswordBox Name="Password2"/>

        <Button Name="btnSave" Content="Save" Width="100" Height="28" Margin="0,5,0,0" HorizontalAlignment="Center" Click="Button_Click"/>
        <ProgressBar Name="progressBar" IsIndeterminate="True" Height="10" Margin="0,12,0,0" Visibility="Collapsed"/>
        <Label Name="Warning" Visibility="Hidden" Foreground="Red" Content="Passwords do not match" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
