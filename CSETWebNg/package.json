    "@angular/cdk": "^20.2.14",
    "@angular/cli": "^20.3.21",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/compiler-cli": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/elements": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/localize": "^20.3.18",
    "@angular/material": "^20.2.14",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@babel/helpers": "^7.29.2",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@jsverse/transloco": "^8.2.1",
    "@kolkov/angular-editor": "^3.0.5",
    "@ng-bootstrap/ng-bootstrap": "^19.0.1",
    "@ngstack/code-editor": "^9.0.0",
    "@swimlane/ngx-charts": "^23.1.0",
    "@types/jquery": "^3.5.33",
    "ag-grid-angular": "^34.3.1",
    "angular-oauth2-oidc": "^20.0.2",
    "@types/sanitize-html": "^2.16.1",
    "angular2-hotkeys": "^16.0.1",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "daisyui": "^5.5.19",
    "dompurify": "^3.3.3",
    "electron-find-on-page": "^1.1.0",
    "electron-log": "^5.4.3",
    "file-saver": "^2.0.5",
    "font-awesome": "^4.7.0",
    "fuse.js": "^7.1.0",
    "html-to-pdfmake": "^2.5.33",
    "jquery": "^4.0.0",
    "locate-path": "^8.0.0",
    "lodash": "^4.17.23",
    "luxon": "^3.7.2",
    "material-design-icons": "^3.0.1",
    "monaco-editor": "^0.55.1",
    "ng2-currency-mask": "^13.0.3",
    "ngx-csv": "^0.3.2",
    "pdfmake": "^0.3.7",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.2",
    "sass": "^1.98.0",
    "style-loader": "^4.0.0",
